-- ============================================================
-- RYZE UI LIBRARY v2.0
-- Aurora background, animated gradient border, spring toggles,
-- ripple buttons, HSV color picker, overlay dropdowns, key system.
-- API giu tuong thich v1.3: CreateWindow / CreateTab / Create*.
-- ============================================================

local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local Debris           = game:GetService("Debris")

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

-- ============================================================
-- CONTAINER + CLEANUP
-- ============================================================
local function getContainer()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end
local Container = getContainer()

local env = (getgenv and getgenv()) or _G
if env.__RYZE_UI_CLEANUP then pcall(env.__RYZE_UI_CLEANUP) end
for _, n in ipairs({ "RYZE_UI", "RYZE_UI_Notify", "RYZE_UI_Key" }) do
    local o = Container:FindFirstChild(n)
    if o then pcall(o.Destroy, o) end
end

local live = {}
env.__RYZE_UI_CLEANUP = function()
    for g in pairs(live) do pcall(g.Destroy, g) end
    table.clear(live)
end

local function mount(gui)
    if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end
    live[gui] = true
    gui.Destroying:Connect(function() live[gui] = nil end)
    gui.Parent = Container
end

-- ============================================================
-- UTILS
-- ============================================================
local function new(class, props)
    local o = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else o[k] = v end
    end
    if parent then o.Parent = parent end
    return o
end

local function addCorner(inst, r)
    return new("UICorner", { CornerRadius = (r >= 100) and UDim.new(1, 0) or UDim.new(0, r), Parent = inst })
end

local function addStroke(inst, color, thickness, transparency)
    return new("UIStroke", {
        Color = color or WHITE,
        Thickness = thickness or 1,
        Transparency = transparency or 0.93,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = inst,
    })
end

local function tween(obj, t, props, style, dir)
    local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function Maid()
    local m = { items = {} }
    function m:Add(x) table.insert(self.items, x) return x end
    function m:Clean()
        for _, c in ipairs(self.items) do
            pcall(function()
                if typeof(c) == "RBXScriptConnection" then c:Disconnect()
                elseif typeof(c) == "Instance" then c:Destroy() end
            end)
        end
        self.items = {}
    end
    return m
end

local function safe(cb, ...)
    if type(cb) ~= "function" then return end
    local ok, err = pcall(cb, ...)
    if not ok then warn("[RYZE UI] callback error: " .. tostring(err)) end
end

local function trim(s) return (tostring(s or ""):match("^%s*(.-)%s*$")) end

local function fmtNum(v)
    if v % 1 == 0 then return tostring(math.floor(v)) end
    return tostring(math.floor(v * 100 + 0.5) / 100)
end

local function utf8Prefix(s, i)
    local e = utf8.offset(s, i + 1)
    return e and s:sub(1, e - 1) or s
end

local function viewport()
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

-- ============================================================
-- THEME
-- ============================================================
local DEFAULT_THEME = {
    BG      = Color3.fromRGB(11, 11, 15),
    PANEL   = Color3.fromRGB(17, 17, 23),
    ELEM    = Color3.fromRGB(25, 25, 33),
    HOVER   = Color3.fromRGB(36, 36, 47),
    ACCENT  = Color3.fromRGB(124, 92, 255),
    ACCENT2 = Color3.fromRGB(64, 190, 255),
    TEXT    = Color3.fromRGB(240, 240, 246),
    MUTED   = Color3.fromRGB(135, 135, 152),
    DANGER  = Color3.fromRGB(240, 72, 86),
    SUCCESS = Color3.fromRGB(80, 205, 130),
    WARNING = Color3.fromRGB(245, 160, 60),
}

local P = {}
local function applyTheme(cfg)
    for k, v in pairs(DEFAULT_THEME) do P[k] = v end
    if typeof(cfg.Accent) == "Color3" then P.ACCENT = cfg.Accent end
    if type(cfg.Theme) == "table" then
        for k, v in pairs(cfg.Theme) do
            if DEFAULT_THEME[k] and typeof(v) == "Color3" then P[k] = v end
        end
    end
end
applyTheme({})

local Lib = {}
Lib.__index = Lib
Lib.Version = "2.0"

-- ============================================================
-- NOTIFY
-- ============================================================
local notifyGui, notifyHolder
local notifyOrder = 0

local function ensureNotify()
    if notifyGui and notifyGui.Parent then return end
    notifyGui = new("ScreenGui", {
        Name = "RYZE_UI_Notify", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 1000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    mount(notifyGui)
    notifyHolder = new("Frame", {
        Size = UDim2.new(0, 320, 1, -24), Position = UDim2.new(1, -332, 0, 12),
        BackgroundTransparency = 1, Parent = notifyGui,
    })
    new("UIListLayout", {
        Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Bottom, Parent = notifyHolder,
    })
end

function Lib:Notify(cfg)
    cfg = cfg or {}
    ensureNotify()
    local title    = tostring(cfg.Title or "Notification")
    local desc     = tostring(cfg.Desc or "")
    local ntype    = cfg.Type or "info"
    local duration = cfg.Duration or 3.5
    local colors = { info = P.ACCENT, success = P.SUCCESS, warning = P.WARNING, error = P.DANGER }
    local glyphs = { info = "i", success = "+", warning = "!", error = "x" }
    local color = colors[ntype] or colors.info
    local H = 68

    notifyOrder += 1
    local wrap = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
        LayoutOrder = notifyOrder, Parent = notifyHolder,
    })
    local card = new("Frame", {
        Size = UDim2.new(1, 0, 0, H), Position = UDim2.new(1, 60, 0, 0),
        BackgroundColor3 = Color3.fromRGB(18, 18, 24), BorderSizePixel = 0,
        ClipsDescendants = true, Parent = wrap,
    })
    addCorner(card, 10)
    addStroke(card, color, 1, 0.75)

    local glow = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = color,
        BackgroundTransparency = 0.93, BorderSizePixel = 0, Parent = card,
    })
    new("UIGradient", {
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
        Parent = glow,
    })

    local badge = new("Frame", {
        Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(12, 12),
        BackgroundColor3 = color, BackgroundTransparency = 0.8, BorderSizePixel = 0, Parent = card,
    })
    addCorner(badge, 8)
    new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = glyphs[ntype] or "i",
        TextColor3 = color, Font = Enum.Font.GothamBlack, TextSize = 15, Parent = badge,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -62, 0, 18), Position = UDim2.fromOffset(52, 10), BackgroundTransparency = 1,
        Text = title, TextColor3 = P.TEXT, Font = Enum.Font.GothamBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -62, 0, 28), Position = UDim2.fromOffset(52, 28), BackgroundTransparency = 1,
        Text = desc, TextColor3 = P.MUTED, Font = Enum.Font.GothamMedium, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true, Parent = card,
    })
    local bar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = color, BorderSizePixel = 0, Parent = card,
    })

    tween(wrap, 0.25, { Size = UDim2.new(1, 0, 0, H) })
    tween(card, 0.45, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
    tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        if not card.Parent then return end
        tween(card, 0.3, { Position = UDim2.new(1, 60, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.wait(0.28)
        if not wrap.Parent then return end
        tween(wrap, 0.22, { Size = UDim2.new(1, 0, 0, 0) })
        Debris:AddItem(wrap, 0.3)
    end)
end

-- ============================================================
-- CLIPBOARD + KEY SYSTEM HELPERS
-- ============================================================
local function copyToClipboard(text)
    local fn = setclipboard or toclipboard or (Clipboard and Clipboard.set)
    if fn then return (pcall(fn, text)) end
    return false
end

local function fetchRemoteKeys(url)
    local body
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" then body = res end
    if not body then
        local http = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
        if http then
            local ok2, r = pcall(http, { Url = url, Method = "GET" })
            if ok2 and r and r.Body then body = r.Body end
        end
    end
    local list = {}
    if body then
        for line in body:gmatch("[^\r\n]+") do
            local t = trim(line)
            if t ~= "" then table.insert(list, t) end
        end
    end
    return list
end

local function buildValidKeys(ks)
    local raw = ks.Key
    if type(raw) == "string" then raw = { raw } elseif type(raw) ~= "table" then raw = {} end
    if not ks.GrabKeyFromSite then return raw end
    local valid = {}
    for _, item in ipairs(raw) do
        if type(item) == "string" and item:match("^https?://") then
            for _, k in ipairs(fetchRemoteKeys(item)) do table.insert(valid, k) end
        else
            table.insert(valid, item)
        end
    end
    return valid
end

local function checkKey(input, valid)
    input = trim(input)
    if input == "" then return false end
    for _, k in ipairs(valid) do
        if trim(k) == input then return true end
    end
    return false
end

local function keyPath(fileName)
    local folder = "RYZE_UI_Keys"
    if isfolder and makefolder and not isfolder(folder) then pcall(makefolder, folder) end
    return folder .. "/" .. tostring(fileName or "key") .. ".txt"
end

local function loadSavedKey(fileName)
    if not (isfile and readfile) then return nil end
    local path = keyPath(fileName)
    local okF, exists = pcall(isfile, path)
    if okF and exists then
        local ok, c = pcall(readfile, path)
        if ok and c and c ~= "" then return c end
    end
    return nil
end

local function saveKey(fileName, key)
    if writefile then pcall(writefile, keyPath(fileName), tostring(key)) end
end

-- ============================================================
-- KEY PROMPT: intro fall + burst -> loading -> key box
-- done(success: boolean) is called exactly once.
-- ============================================================
local function showKeyPrompt(ks, valid, done)
    local alive, finished = true, false
    local gui = new("ScreenGui", {
        Name = "RYZE_UI_Key", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 10000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    mount(gui)
    gui.Destroying:Connect(function()
        alive = false
        if not finished then finished = true; done(false) end
    end)

    local function sleep(t) task.wait(t) return alive end

    local bg = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(4, 4, 8),
        BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, Parent = gui,
    })
    tween(bg, 0.4, { BackgroundTransparency = 0.25 })

    -- soft color wash
    local wash = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.88,
        BorderSizePixel = 0, ZIndex = 1, Parent = bg,
    })
    local washGrad = new("UIGradient", {
        Rotation = 45,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, P.ACCENT), ColorSequenceKeypoint.new(0.5, P.BG), ColorSequenceKeypoint.new(1, P.ACCENT2),
        }),
        Parent = wash,
    })
    tween(washGrad, 12, { Rotation = 405 }, Enum.EasingStyle.Linear)
    task.spawn(function()
        while alive do
            washGrad.Rotation = 45
            tween(washGrad, 14, { Rotation = 405 }, Enum.EasingStyle.Linear)
            if not sleep(14) then return end
        end
    end)

    -- snow
    task.spawn(function()
        while alive do
            local sz = math.random(2, 4)
            local x = math.random()
            local flake = new("Frame", {
                Size = UDim2.fromOffset(sz, sz), Position = UDim2.new(x, 0, -0.05, 0),
                BackgroundColor3 = WHITE, BackgroundTransparency = math.random(30, 70) / 100,
                BorderSizePixel = 0, ZIndex = 2, Parent = bg,
            })
            addCorner(flake, 100)
            local dur = math.random(40, 80) / 10
            tween(flake, dur, {
                Position = UDim2.new(x + (math.random() - 0.5) * 0.15, 0, 1.05, 0),
            }, Enum.EasingStyle.Linear)
            Debris:AddItem(flake, dur + 0.1)
            if not sleep(math.random(8, 20) / 100) then return end
        end
    end)

    -- intro title
    local holder = new("Frame", {
        Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, -0.45),
        AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 50, Parent = bg,
    })
    local holderScale = new("UIScale", { Scale = 1, Parent = holder })
    local titleText = ks.Title or "RYZE HUB"

    local function mkText(size, color, z, trans)
        return new("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = titleText,
            TextColor3 = color, Font = Enum.Font.GothamBlack, TextSize = size,
            TextTransparency = trans, ZIndex = z, Parent = holder,
        })
    end
    local glow  = mkText(74, P.ACCENT, 49, 0.82)
    local intro = mkText(56, Color3.fromRGB(238, 238, 248), 51, 0)
    local shine = mkText(56, WHITE, 52, 0)
    new("UIStroke", { Color = P.ACCENT, Thickness = 1.5, Transparency = 0.5, Parent = intro })
    local shineGrad = new("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 1),
            NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(0.58, 1), NumberSequenceKeypoint.new(1, 1),
        }),
        Offset = Vector2.new(-1, 0), Parent = shine,
    })
    task.spawn(function()
        if not sleep(0.9) then return end
        while alive and shine.Parent do
            shineGrad.Offset = Vector2.new(-1, 0)
            tween(shineGrad, 0.8, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Quad)
            if not sleep(2.2) then return end
        end
    end)

    -- key box
    local vp = viewport()
    local boxW = math.min(440, vp.X - 30)
    local box = new("Frame", {
        Size = UDim2.fromOffset(boxW, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.fromScale(0.5, -0.6), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, Visible = false, ZIndex = 20, Parent = bg,
    })
    addCorner(box, 16)
    new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(Color3.fromRGB(26, 26, 34), Color3.fromRGB(15, 15, 20)),
        Parent = box,
    })
    local boxStroke = addStroke(box, P.ACCENT, 1.5, 0.45)

    local content = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = box,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 22), PaddingBottom = UDim.new(0, 22),
        PaddingLeft = UDim.new(0, 24), PaddingRight = UDim.new(0, 24), Parent = content,
    })
    new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = content })

    local closeBtn = new("TextButton", {
        Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -14, 0, 14), AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = P.ELEM, BackgroundTransparency = 0.3, Text = "x", TextColor3 = P.MUTED,
        Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false, ZIndex = 30, Parent = box,
    })
    addCorner(closeBtn, 8)
    closeBtn.MouseEnter:Connect(function()
        tween(closeBtn, 0.12, { BackgroundColor3 = P.DANGER, BackgroundTransparency = 0, TextColor3 = WHITE })
    end)
    closeBtn.MouseLeave:Connect(function()
        tween(closeBtn, 0.12, { BackgroundColor3 = P.ELEM, BackgroundTransparency = 0.3, TextColor3 = P.MUTED })
    end)

    local titleRow = new("Frame", { Size = UDim2.new(1, -34, 0, 26), BackgroundTransparency = 1, LayoutOrder = 1, Parent = content })
    local accentBar = new("Frame", {
        Size = UDim2.fromOffset(4, 22), Position = UDim2.new(0, 0, 0.5, -11),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = titleRow,
    })
    addCorner(accentBar, 100)
    new("UIGradient", { Rotation = 90, Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = accentBar })
    new("TextLabel", {
        Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(16, 0), BackgroundTransparency = 1,
        Text = ks.Title or "Key System", TextColor3 = P.TEXT, Font = Enum.Font.GothamBold, TextSize = 19,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = titleRow,
    })
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Text = ks.Subtitle or "Enter your key to continue", TextColor3 = P.MUTED, Font = Enum.Font.GothamMedium,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = 2, Parent = content,
    })
    if ks.Note and ks.Note ~= "" then
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            Text = ks.Note, TextColor3 = Color3.fromRGB(125, 125, 142), Font = Enum.Font.Gotham, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true, LayoutOrder = 3, Parent = content,
        })
    end
    new("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundTransparency = 1, LayoutOrder = 4, Parent = content })

    local inputRow = new("Frame", {
        Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = P.ELEM, BorderSizePixel = 0, LayoutOrder = 5, Parent = content,
    })
    addCorner(inputRow, 10)
    local inputStroke = addStroke(inputRow, WHITE, 1, 0.9)
    local inputBox = new("TextBox", {
        Size = UDim2.new(1, -112, 1, 0), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1,
        PlaceholderText = "Paste your key here...", PlaceholderColor3 = P.MUTED, Text = "",
        TextColor3 = P.TEXT, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, Parent = inputRow,
    })
    local verifyBtn = new("TextButton", {
        Size = UDim2.new(0, 92, 1, -10), Position = UDim2.new(1, -98, 0, 5), BackgroundColor3 = WHITE,
        Text = "Verify", TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 12,
        AutoButtonColor = false, Parent = inputRow,
    })
    addCorner(verifyBtn, 8)
    new("UIGradient", { Rotation = 20, Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = verifyBtn })
    local vScale = new("UIScale", { Parent = verifyBtn })
    verifyBtn.MouseButton1Down:Connect(function() tween(vScale, 0.08, { Scale = 0.94 }) end)
    verifyBtn.MouseButton1Up:Connect(function() tween(vScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back) end)
    verifyBtn.MouseLeave:Connect(function() tween(vScale, 0.15, { Scale = 1 }) end)
    inputBox.Focused:Connect(function() tween(inputStroke, 0.15, { Color = P.ACCENT, Transparency = 0.2 }) end)
    inputBox.FocusLost:Connect(function() tween(inputStroke, 0.15, { Color = WHITE, Transparency = 0.9 }) end)

    local status = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Text = "", TextColor3 = P.DANGER, Font = Enum.Font.GothamMedium, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = 6, Parent = content,
    })

    local links = ks.Links or {}
    if #links > 0 then
        new("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Color3.fromRGB(38, 38, 48), BorderSizePixel = 0, LayoutOrder = 10, Parent = content })
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Text = "Need a key? Click a link to copy it.",
            TextColor3 = P.MUTED, Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 11, Parent = content,
        })
        for i, link in ipairs(links) do
            local lb = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = P.ELEM, BackgroundTransparency = 0.5,
                Text = "", AutoButtonColor = false, LayoutOrder = 12 + i, Parent = content,
            })
            addCorner(lb, 8)
            new("TextLabel", {
                Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 10, 0.5, -8), BackgroundTransparency = 1,
                Text = ">", TextColor3 = P.ACCENT, Font = Enum.Font.GothamBold, TextSize = 13, Parent = lb,
            })
            new("TextLabel", {
                Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(30, 0), BackgroundTransparency = 1,
                Text = tostring(link.Name or "Link"), TextColor3 = P.TEXT, Font = Enum.Font.GothamMedium,
                TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = lb,
            })
            local hint = new("TextLabel", {
                Size = UDim2.new(0, 70, 1, 0), Position = UDim2.new(1, -78, 0, 0), BackgroundTransparency = 1,
                Text = "copy", TextColor3 = P.MUTED, Font = Enum.Font.GothamMedium, TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Right, Parent = lb,
            })
            lb.MouseEnter:Connect(function() tween(lb, 0.12, { BackgroundColor3 = P.HOVER, BackgroundTransparency = 0.1 }) end)
            lb.MouseLeave:Connect(function()
                tween(lb, 0.12, { BackgroundColor3 = P.ELEM, BackgroundTransparency = 0.5 })
            end)
            lb.MouseButton1Click:Connect(function()
                local ok = link.Url and copyToClipboard(link.Url)
                hint.Text = ok and "copied" or "no clipboard"
                hint.TextColor3 = ok and P.SUCCESS or P.DANGER
                task.delay(1.4, function()
                    if hint.Parent then hint.Text = "copy"; hint.TextColor3 = P.MUTED end
                end)
            end)
        end
    end

    local function leave(ok)
        if finished then return end
        finished = true
        alive = false
        tween(box, 0.3, { Position = UDim2.fromScale(0.5, -0.6) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        tween(bg, 0.3, { BackgroundTransparency = 1 })
        task.wait(0.32)
        gui:Destroy()
        done(ok)
    end

    local busy = false
    local function shake()
        local orig = box.Position
        for _ = 1, 3 do
            tween(box, 0.04, { Position = orig + UDim2.fromOffset(8, 0) })
            task.wait(0.045)
            tween(box, 0.04, { Position = orig - UDim2.fromOffset(8, 0) })
            task.wait(0.045)
        end
        tween(box, 0.05, { Position = orig })
    end
    local function submit()
        if busy or finished then return end
        busy = true
        local entered = trim(inputBox.Text)
        if checkKey(entered, valid) then
            if ks.SaveKey ~= false then saveKey(ks.FileName, entered) end
            tween(boxStroke, 0.2, { Color = P.SUCCESS, Transparency = 0.1 })
            task.wait(0.25)
            leave(true)
            return
        end
        status.Text = "Invalid key, try again."
        tween(boxStroke, 0.15, { Color = P.DANGER, Transparency = 0.1 })
        inputBox.Text = ""
        shake()
        tween(boxStroke, 0.4, { Color = P.ACCENT, Transparency = 0.45 })
        busy = false
    end
    verifyBtn.MouseButton1Click:Connect(function() task.spawn(submit) end)
    inputBox.FocusLost:Connect(function(enter) if enter then task.spawn(submit) end end)
    inputBox:GetPropertyChangedSignal("Text"):Connect(function() status.Text = "" end)
    closeBtn.MouseButton1Click:Connect(function() task.spawn(leave, false) end)

    -- sequence
    task.spawn(function()
        if not sleep(0.15) then return end
        tween(holder, 0.95, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)
        if not sleep(1.3) then return end

        -- burst
        local cx, cy = bg.AbsoluteSize.X * 0.5, bg.AbsoluteSize.Y * 0.5
        for i = 1, 64 do
            local ang = (i / 64) * math.pi * 2 + (math.random() - 0.5) * 0.2
            local s = math.random(3, 8)
            local p = new("Frame", {
                Size = UDim2.fromOffset(s, s), Position = UDim2.fromOffset(cx, cy), AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = P.ACCENT:Lerp(P.ACCENT2, math.random()):Lerp(WHITE, math.random() * 0.4),
                BorderSizePixel = 0, Rotation = math.random(0, 360), ZIndex = 52, Parent = bg,
            })
            addCorner(p, math.random(0, 1) * 100 + 1)
            local dist, dur = math.random(180, 420), math.random(60, 120) / 100
            tween(p, dur, {
                Position = UDim2.fromOffset(cx + math.cos(ang) * dist, cy + math.sin(ang) * dist),
                BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1), Rotation = p.Rotation + math.random(-400, 400),
            })
            Debris:AddItem(p, dur + 0.05)
        end
        tween(holderScale, 0.35, { Scale = 0.2 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        for _, l in ipairs({ glow, intro, shine }) do tween(l, 0.3, { TextTransparency = 1 }) end
        for _, o in ipairs(intro:GetChildren()) do
            if o:IsA("UIStroke") then tween(o, 0.3, { Transparency = 1 }) end
        end
        if not sleep(0.4) then return end
        holder:Destroy()

        -- loading
        local load = new("Frame", {
            Size = UDim2.fromOffset(math.min(340, vp.X - 40), 0), AutomaticSize = Enum.AutomaticSize.Y,
            Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1, ZIndex = 60, Parent = bg,
        })
        local loadScale = new("UIScale", { Scale = 0.9, Parent = load })
        tween(loadScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
        new("UIListLayout", {
            Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder,
            HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = load,
        })
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = titleText, TextColor3 = P.TEXT,
            Font = Enum.Font.GothamBold, TextSize = 18, LayoutOrder = 1, ZIndex = 61, Parent = load,
        })
        local track = new("Frame", {
            Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = Color3.fromRGB(30, 30, 40),
            BorderSizePixel = 0, LayoutOrder = 2, ZIndex = 61, Parent = load,
        })
        addCorner(track, 100)
        local fill = new("Frame", {
            Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 62, Parent = track,
        })
        addCorner(fill, 100)
        new("UIGradient", { Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = fill })
        local statusRow = new("Frame", { Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, LayoutOrder = 3, ZIndex = 61, Parent = load })
        local phase = new("TextLabel", {
            Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, Text = "Initializing...",
            TextColor3 = P.MUTED, Font = Enum.Font.GothamMedium, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 61, Parent = statusRow,
        })
        local pct = new("TextLabel", {
            Size = UDim2.new(0, 50, 1, 0), Position = UDim2.new(1, -50, 0, 0), BackgroundTransparency = 1,
            Text = "0%", TextColor3 = P.ACCENT, Font = Enum.Font.GothamBold, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 61, Parent = statusRow,
        })
        local phases = {
            { "Loading UI...", 0.20, 0.35 }, { "Loading features...", 0.45, 0.45 },
            { "Loading modules...", 0.68, 0.45 }, { "Preparing key check...", 0.88, 0.45 }, { "Ready", 1, 0.3 },
        }
        for _, ph in ipairs(phases) do
            phase.Text = ph[1]
            pct.Text = math.floor(ph[2] * 100) .. "%"
            tween(fill, ph[3], { Size = UDim2.new(ph[2], 0, 1, 0) })
            if not sleep(ph[3]) then return end
        end
        if not sleep(0.15) then return end
        tween(loadScale, 0.28, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        for _, el in ipairs(load:GetDescendants()) do
            if el:IsA("TextLabel") then tween(el, 0.25, { TextTransparency = 1 })
            elseif el:IsA("Frame") then tween(el, 0.25, { BackgroundTransparency = 1 }) end
        end
        if not sleep(0.3) then return end
        load:Destroy()

        box.Visible = true
        tween(box, 0.6, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
        if not sleep(0.6) then return end
        pcall(function() inputBox:CaptureFocus() end)
    end)
end

-- ============================================================
-- BUILDER HELPERS
-- ============================================================
local B = {}

local function nextOrder(win)
    win._order += 1
    return win._order
end

local function register(win, name, obj, page)
    table.insert(win.Elements, { Name = tostring(name), Obj = obj, Page = page })
end

local function row(win, page, height, class)
    local f = new(class or "Frame", {
        Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = P.ELEM, BackgroundTransparency = 0.12,
        BorderSizePixel = 0, LayoutOrder = nextOrder(win), Parent = page,
    })
    if class == "TextButton" then f.Text = ""; f.AutoButtonColor = false end
    addCorner(f, 10)
    local s = addStroke(f, WHITE, 1, 0.94)
    return f, s
end

local function hoverable(f, s, base, hover)
    f.MouseEnter:Connect(function()
        tween(f, 0.15, { BackgroundColor3 = hover })
        if s then tween(s, 0.15, { Transparency = 0.84 }) end
    end)
    f.MouseLeave:Connect(function()
        tween(f, 0.15, { BackgroundColor3 = base })
        if s then tween(s, 0.15, { Transparency = 0.94 }) end
    end)
end

local function rowLabel(parent, text, rightPad)
    return new("TextLabel", {
        Size = UDim2.new(1, -(rightPad or 12) - 12, 1, 0), Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = tostring(text), TextColor3 = P.TEXT, Font = Enum.Font.GothamMedium,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = parent,
    })
end

-- generic drag helper (sliders, color picker). Disables parent scroll while dragging.
local function bindDrag(win, area, onMove)
    local dragging, scroller = false, nil
    area.InputBegan:Connect(function(i)
        if isPress(i) then
            dragging = true
            scroller = area:FindFirstAncestorWhichIsA("ScrollingFrame")
            if scroller then scroller.ScrollingEnabled = false end
            onMove(i.Position.X, i.Position.Y, true)
        end
    end)
    win._maid:Add(UserInputService.InputChanged:Connect(function(i)
        if dragging and isMove(i) then onMove(i.Position.X, i.Position.Y, false) end
    end))
    win._maid:Add(UserInputService.InputEnded:Connect(function(i)
        if dragging and isPress(i) then
            dragging = false
            if scroller then scroller.ScrollingEnabled = true; scroller = nil end
            onMove(nil, nil, false, true)
        end
    end))
end

-- ============================================================
-- ELEMENTS
-- ============================================================
function B.Section(win, page, title)
    local f = new("Frame", {
        Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = nextOrder(win), Parent = page,
    })
    local dot = new("Frame", {
        Size = UDim2.fromOffset(3, 12), Position = UDim2.new(0, 2, 1, -18), BackgroundColor3 = WHITE,
        BorderSizePixel = 0, Parent = f,
    })
    addCorner(dot, 100)
    new("UIGradient", { Rotation = 90, Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = dot })
    new("TextLabel", {
        Size = UDim2.new(1, -14, 0, 14), Position = UDim2.new(0, 12, 1, -19), BackgroundTransparency = 1,
        Text = string.upper(tostring(title)), TextColor3 = P.MUTED, Font = Enum.Font.GothamBold, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    return f
end

function B.Divider(win, page)
    local f = new("Frame", {
        Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.93,
        BorderSizePixel = 0, LayoutOrder = nextOrder(win), Parent = page,
    })
    return f
end

function B.Button(win, page, cfg)
    local text = cfg.Name or "Button"
    local danger = cfg.Danger and true or false
    local base  = danger and Color3.fromRGB(44, 24, 30) or P.ELEM
    local hover = danger and Color3.fromRGB(62, 30, 38) or P.HOVER

    local btn, s = row(win, page, 34, "TextButton")
    btn.BackgroundColor3 = base
    btn.ClipsDescendants = true
    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = text,
        TextColor3 = danger and Color3.fromRGB(255, 125, 135) or P.TEXT, Font = Enum.Font.GothamMedium,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
    })
    local chev = new("TextLabel", {
        Size = UDim2.fromOffset(16, 16), Position = UDim2.new(1, -26, 0.5, -8), BackgroundTransparency = 1,
        Text = ">", TextColor3 = danger and P.DANGER or P.ACCENT, Font = Enum.Font.GothamBold, TextSize = 13, Parent = btn,
    })
    hoverable(btn, s, base, hover)
    btn.MouseEnter:Connect(function() tween(chev, 0.2, { Position = UDim2.new(1, -22, 0.5, -8) }) end)
    btn.MouseLeave:Connect(function() tween(chev, 0.2, { Position = UDim2.new(1, -26, 0.5, -8) }) end)

    btn.InputBegan:Connect(function(i)
        if not isPress(i) then return end
        local rel = Vector2.new(i.Position.X, i.Position.Y) - btn.AbsolutePosition
        local r = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(rel.X, rel.Y), Size = UDim2.fromOffset(0, 0),
            BackgroundColor3 = danger and P.DANGER or P.ACCENT, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = btn,
        })
        addCorner(r, 100)
        local d = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.4
        tween(r, 0.55, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 })
        Debris:AddItem(r, 0.6)
    end)
    btn.MouseButton1Click:Connect(function() safe(cfg.Callback) end)

    register(win, text, btn, page)
    local api = {}
    function api:SetText(t) lbl.Text = tostring(t) end
    return api, btn
end

function B.Toggle(win, page, cfg)
    local text = cfg.Name or "Toggle"
    local on = cfg.Default and true or false
    local OFF = Color3.fromRGB(48, 48, 60)

    local f, s = row(win, page, 34, "TextButton")
    hoverable(f, s, P.ELEM, P.HOVER)
    rowLabel(f, text, 56)

    local track = new("Frame", {
        Size = UDim2.fromOffset(36, 18), Position = UDim2.new(1, -48, 0.5, -9),
        BackgroundColor3 = on and P.ACCENT or OFF, BorderSizePixel = 0, Parent = f,
    })
    addCorner(track, 100)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(12, 12), Position = on and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = track,
    })
    addCorner(knob, 100)

    local function render(animate)
        local c = on and P.ACCENT or OFF
        local p = on and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
        if animate then
            tween(track, 0.25, { BackgroundColor3 = c })
            tween(knob, 0.3, { Position = p }, Enum.EasingStyle.Back)
        else
            track.BackgroundColor3 = c
            knob.Position = p
        end
    end

    f.MouseButton1Click:Connect(function()
        on = not on
        render(true)
        safe(cfg.Callback, on)
    end)

    register(win, text, f, page)
    local api = {}
    function api:Get() return on end
    function api:Set(v)
        v = v and true or false
        if v == on then return end
        on = v
        render(true)
        safe(cfg.Callback, on)
    end
    return api, f
end

function B.Slider(win, page, cfg)
    local text = cfg.Name or "Slider"
    local minV, maxV = cfg.Min or 0, cfg.Max or 100
    if maxV <= minV then maxV = minV + 1 end
    local inc = (cfg.Increment and cfg.Increment > 0) and cfg.Increment or 1
    local suffix = cfg.Suffix or ""

    local function snap(v)
        v = math.clamp(v, minV, maxV)
        v = minV + math.floor((v - minV) / inc + 0.5) * inc
        v = math.floor(v * 10000 + 0.5) / 10000
        return math.clamp(v, minV, maxV)
    end
    local current = snap(cfg.Default or minV)

    local f = row(win, page, 50)
    rowLabel(f, text, 80)
    local valLbl = new("TextLabel", {
        Size = UDim2.new(0, 70, 0, 20), Position = UDim2.new(1, -82, 0, 6), BackgroundTransparency = 1,
        Text = fmtNum(current) .. suffix, TextColor3 = P.ACCENT, Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right, Parent = f,
    })
    f.TextLabel.Size = UDim2.new(1, -100, 0, 20)
    f.TextLabel.Position = UDim2.fromOffset(12, 6)

    local area = new("Frame", {
        Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, 26), BackgroundTransparency = 1, Parent = f,
    })
    local bar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0.5, -3), BackgroundColor3 = Color3.fromRGB(16, 16, 22),
        BorderSizePixel = 0, Parent = area,
    })
    addCorner(bar, 100)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = bar })
    addCorner(fill, 100)
    new("UIGradient", { Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = fill })
    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Parent = bar,
    })
    addCorner(knob, 100)
    local knobStroke = addStroke(knob, P.ACCENT, 2, 0)

    local function render()
        local p = (current - minV) / (maxV - minV)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        valLbl.Text = fmtNum(current) .. suffix
    end
    render()

    bindDrag(win, area, function(x, _, began, ended)
        if ended then tween(knob, 0.15, { Size = UDim2.fromOffset(14, 14) }) return end
        if began then tween(knob, 0.15, { Size = UDim2.fromOffset(18, 18) }) end
        local w = bar.AbsoluteSize.X
        if w <= 0 then return end
        local p = math.clamp((x - bar.AbsolutePosition.X) / w, 0, 1)
        local v = snap(minV + p * (maxV - minV))
        if v ~= current then
            current = v
            render()
            safe(cfg.Callback, v)
        end
    end)

    register(win, text, f, page)
    local api = {}
    function api:Get() return current end
    function api:Set(v)
        current = snap(v)
        render()
        safe(cfg.Callback, current)
    end
    return api, f
end

function B.Input(win, page, cfg)
    local text = cfg.Name or "Input"
    local f = row(win, page, 62)
    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 6), BackgroundTransparency = 1,
        Text = text, TextColor3 = P.MUTED, Font = Enum.Font.GothamSemibold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    local boxBg = new("Frame", {
        Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 26), BackgroundColor3 = P.BG,
        BorderSizePixel = 0, Parent = f,
    })
    addCorner(boxBg, 8)
    local st = addStroke(boxBg, WHITE, 1, 0.92)
    local box = new("TextBox", {
        Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
        Text = tostring(cfg.Default or ""), PlaceholderText = cfg.Placeholder or "", PlaceholderColor3 = P.MUTED,
        TextColor3 = P.TEXT, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, Parent = boxBg,
    })
    box.Focused:Connect(function() tween(st, 0.15, { Color = P.ACCENT, Transparency = 0.2 }) end)
    box.FocusLost:Connect(function(enter)
        tween(st, 0.15, { Color = WHITE, Transparency = 0.92 })
        safe(cfg.Callback, box.Text, enter)
    end)

    register(win, text, f, page)
    local api = {}
    function api:Get() return box.Text end
    function api:Set(v) box.Text = tostring(v) end
    return api, f
end

function B.Dropdown(win, page, cfg)
    local text = cfg.Name or "Dropdown"
    local options = cfg.Options or {}
    local current = cfg.Default or options[1]

    local f, s = row(win, page, 36, "TextButton")
    hoverable(f, s, P.ELEM, P.HOVER)
    rowLabel(f, text, 150)
    f.TextLabel.Size = UDim2.new(0.5, -12, 1, 0)
    local valLbl = new("TextLabel", {
        Size = UDim2.new(0.5, -40, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1,
        Text = tostring(current or "-"), TextColor3 = P.ACCENT, Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Parent = f,
    })
    local arrow = new("TextLabel", {
        Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -28, 0.5, -10), BackgroundTransparency = 1,
        Text = ">", TextColor3 = P.MUTED, Font = Enum.Font.GothamBold, TextSize = 12, Rotation = 90, Parent = f,
    })

    local overlay
    local function close()
        if overlay then overlay:Destroy(); overlay = nil end
        tween(arrow, 0.2, { Rotation = 90 })
    end

    local function select(opt)
        current = opt
        valLbl.Text = tostring(opt)
        close()
        safe(cfg.Callback, opt)
    end

    local function open()
        close()
        local gui = win.Gui
        overlay = new("TextButton", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
            ZIndex = 100, Parent = gui,
        })
        overlay.MouseButton1Click:Connect(close)

        local h = math.min(#options * 30 + 8, 200)
        local pos = f.AbsolutePosition - gui.AbsolutePosition
        local y = pos.Y + f.AbsoluteSize.Y + 4
        if y + h > gui.AbsoluteSize.Y - 8 then y = pos.Y - h - 4 end

        local list = new("Frame", {
            Size = UDim2.fromOffset(f.AbsoluteSize.X, 0), Position = UDim2.fromOffset(pos.X, y),
            BackgroundColor3 = P.PANEL, BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 101, Parent = overlay,
        })
        addCorner(list, 10)
        addStroke(list, P.ACCENT, 1, 0.6)
        local sc = new("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
            ScrollBarImageColor3 = P.ACCENT, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 102, Parent = list,
        })
        new("UIListLayout", { Padding = UDim.new(0, 2), Parent = sc })
        new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = sc })

        for _, opt in ipairs(options) do
            local sel = (opt == current)
            local ob = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = sel and P.ACCENT or P.ELEM,
                BackgroundTransparency = sel and 0.75 or 1, Text = "  " .. tostring(opt),
                TextColor3 = sel and P.TEXT or P.MUTED, Font = Enum.Font.GothamMedium, TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, ZIndex = 103, Parent = sc,
            })
            addCorner(ob, 7)
            ob.MouseEnter:Connect(function()
                if opt ~= current then tween(ob, 0.1, { BackgroundTransparency = 0.5, TextColor3 = P.TEXT }) end
            end)
            ob.MouseLeave:Connect(function()
                if opt ~= current then tween(ob, 0.1, { BackgroundTransparency = 1, TextColor3 = P.MUTED }) end
            end)
            ob.MouseButton1Click:Connect(function() select(opt) end)
        end
        tween(list, 0.22, { Size = UDim2.fromOffset(f.AbsoluteSize.X, h) })
        tween(arrow, 0.2, { Rotation = -90 })
    end

    f.MouseButton1Click:Connect(function()
        if overlay then close() else open() end
    end)

    register(win, text, f, page)
    local api = {}
    function api:Get() return current end
    function api:Set(v) current = v; valLbl.Text = tostring(v); safe(cfg.Callback, v) end
    function api:Refresh(newOptions, keep)
        options = newOptions or {}
        if not keep or not table.find(options, current) then
            current = options[1]
            valLbl.Text = tostring(current or "-")
        end
    end
    return api, f
end

function B.Keybind(win, page, cfg)
    local text = cfg.Name or "Keybind"
    local key = cfg.Default or Enum.KeyCode.Unknown

    local f, s = row(win, page, 34)
    hoverable(f, s, P.ELEM, P.HOVER)
    rowLabel(f, text, 100)
    local chip = new("TextButton", {
        Size = UDim2.new(0, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.X, Position = UDim2.new(1, -10, 0.5, -11),
        AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = P.BG, Text = key.Name, TextColor3 = P.ACCENT,
        Font = Enum.Font.GothamBold, TextSize = 11, AutoButtonColor = false, Parent = f,
    })
    addCorner(chip, 6)
    addStroke(chip, P.ACCENT, 1, 0.7)
    new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = chip })

    local waiting = false
    chip.MouseButton1Click:Connect(function()
        waiting = true
        chip.Text = "..."
    end)
    win._maid:Add(UserInputService.InputBegan:Connect(function(input, gp)
        if waiting then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                waiting = false
                if input.KeyCode ~= Enum.KeyCode.Escape then
                    key = input.KeyCode
                    safe(cfg.Callback, key)
                end
                chip.Text = key.Name
            end
            return
        end
        if gp or not cfg.Pressed then return end
        if key ~= Enum.KeyCode.Unknown and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
            safe(cfg.Pressed, key)
        end
    end))

    register(win, text, f, page)
    local api = {}
    function api:Get() return key end
    function api:Set(k) key = k; chip.Text = k.Name; safe(cfg.Callback, k) end
    return api, f
end

function B.Colorpicker(win, page, cfg)
    local text = cfg.Name or "Color"
    local h, s, v = (cfg.Default or P.ACCENT):ToHSV()
    local expanded = false
    local HEAD, FULL = 36, 168

    local f = row(win, page, HEAD)
    f.ClipsDescendants = true
    local head = new("TextButton", {
        Size = UDim2.new(1, 0, 0, HEAD), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = f,
    })
    rowLabel(head, text, 70)
    local swatch = new("Frame", {
        Size = UDim2.fromOffset(40, 18), Position = UDim2.new(1, -52, 0.5, -9), BackgroundColor3 = Color3.fromHSV(h, s, v),
        BorderSizePixel = 0, Parent = head,
    })
    addCorner(swatch, 6)
    addStroke(swatch, WHITE, 1, 0.8)

    local sv = new("Frame", {
        Size = UDim2.new(1, -24, 0, 100), Position = UDim2.fromOffset(12, HEAD + 4), BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        BorderSizePixel = 0, ClipsDescendants = true, Parent = f,
    })
    addCorner(sv, 8)
    local white = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = sv })
    new("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
    local black = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0, Parent = sv })
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
    local cursor = new("Frame", {
        Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 5, Parent = sv,
    })
    addCorner(cursor, 100)
    addStroke(cursor, WHITE, 2, 0)

    local hue = new("Frame", {
        Size = UDim2.new(1, -24, 0, 12), Position = UDim2.fromOffset(12, HEAD + 112), BackgroundColor3 = WHITE,
        BorderSizePixel = 0, Parent = f,
    })
    addCorner(hue, 100)
    local kps = {}
    for i = 0, 6 do table.insert(kps, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 >= 1 and 0 or i / 6, 1, 1))) end
    new("UIGradient", { Color = ColorSequence.new(kps), Parent = hue })
    local hueKnob = new("Frame", {
        Size = UDim2.fromOffset(8, 16), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE,
        BorderSizePixel = 0, ZIndex = 5, Parent = hue,
    })
    addCorner(hueKnob, 4)
    addStroke(hueKnob, BLACK, 1, 0.5)

    local function render(silent)
        local col = Color3.fromHSV(h, s, v)
        swatch.BackgroundColor3 = col
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        cursor.Position = UDim2.fromScale(s, 1 - v)
        hueKnob.Position = UDim2.fromScale(h, 0.5)
        if not silent then safe(cfg.Callback, col) end
    end
    render(true)

    bindDrag(win, sv, function(x, y, _, ended)
        if ended then return end
        s = math.clamp((x - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
        v = 1 - math.clamp((y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
        render()
    end)
    bindDrag(win, hue, function(x, _, _, ended)
        if ended then return end
        h = math.clamp((x - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 1)
        render()
    end)

    head.MouseButton1Click:Connect(function()
        expanded = not expanded
        tween(f, 0.3, { Size = UDim2.new(1, 0, 0, expanded and FULL or HEAD) })
    end)

    register(win, text, f, page)
    local api = {}
    function api:Get() return Color3.fromHSV(h, s, v) end
    function api:Set(c) h, s, v = c:ToHSV(); render() end
    return api, f
end

function B.Label(win, page, text)
    local lbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Text = tostring(text), TextColor3 = P.MUTED, Font = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = nextOrder(win), Parent = page,
    })
    new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2), Parent = lbl })
    register(win, text, lbl, page)
    local api = {}
    function api:Set(v) lbl.Text = tostring(v) end
    return api, lbl
end

function B.Paragraph(win, page, cfg)
    cfg = cfg or {}
    local title = cfg.Title or "Info"
    local f = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = P.ELEM,
        BackgroundTransparency = 0.12, BorderSizePixel = 0, LayoutOrder = nextOrder(win), Parent = page,
    })
    addCorner(f, 10)
    addStroke(f, WHITE, 1, 0.94)
    local bar = new("Frame", {
        Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(0, 8), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = f,
    })
    addCorner(bar, 100)
    new("UIGradient", { Rotation = 90, Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = bar })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 12), Parent = f,
    })
    new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = f })
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = title,
        TextColor3 = P.TEXT, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, LayoutOrder = 1, Parent = f,
    })
    local c = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Text = tostring(cfg.Content or ""), TextColor3 = P.MUTED, Font = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
        LayoutOrder = 2, Parent = f,
    })
    register(win, title, f, page)
    local api = {}
    function api:SetContent(v) c.Text = tostring(v) end
    return api, f
end

-- ============================================================
-- WINDOW CORE
-- ============================================================
function Lib:_CreateWindowCore(cfg)
    cfg = cfg or {}
    applyTheme(cfg)

    local win = {
        Title = tostring(cfg.Title or "RYZE UI"),
        Tabs = {}, TabButtons = {}, Elements = {},
        CurrentPage = nil, CurrentName = nil,
        _order = 0, _tabCount = 0, _maid = Maid(),
    }
    local maid = win._maid
    local alive = true

    local gui = new("ScreenGui", {
        Name = "RYZE_UI", ResetOnSpawn = false, IgnoreGuiInset = false,
        DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    mount(gui)
    win.Gui = gui
    gui.Destroying:Connect(function()
        alive = false
        maid:Clean()
    end)

    local req = cfg.Size or UDim2.fromOffset(660, 470)
    local vp = viewport()
    local W = math.min(req.X.Offset > 0 and req.X.Offset or 660, vp.X - 24)
    local H = math.min(req.Y.Offset > 0 and req.Y.Offset or 470, vp.Y - 60)
    local fullSize = UDim2.fromOffset(W, H)

    local main = new("Frame", {
        Size = fullSize, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        BackgroundColor3 = P.BG, BorderSizePixel = 0, ClipsDescendants = true, Parent = gui,
    })
    addCorner(main, 16)
    local winScale = new("UIScale", { Scale = 0.88, Parent = main })
    tween(winScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)

    -- animated gradient border
    local border = addStroke(main, WHITE, 1.5, 0.35)
    local borderGrad = new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, P.ACCENT), ColorSequenceKeypoint.new(0.35, P.BG),
            ColorSequenceKeypoint.new(0.65, P.ACCENT2), ColorSequenceKeypoint.new(1, P.ACCENT),
        }),
        Parent = border,
    })
    maid:Add(RunService.Heartbeat:Connect(function(dt)
        if main.Visible then borderGrad.Rotation = (borderGrad.Rotation + dt * 45) % 360 end
    end))

    -- aurora background
    local bgLayer = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ClipsDescendants = true, ZIndex = 1, Parent = main,
    })
    if cfg.BgAnimation ~= false then
        local orbs = {
            { P.ACCENT,  300, UDim2.fromScale(-0.05, -0.1), UDim2.fromScale(0.45, 0.35), 11 },
            { P.ACCENT2, 260, UDim2.fromScale(0.75, 0.55),  UDim2.fromScale(0.45, 0.05), 13 },
            { P.ACCENT,  220, UDim2.fromScale(0.35, 0.85),  UDim2.fromScale(0.65, 0.6),  15 },
        }
        for _, o in ipairs(orbs) do
            local orb = new("Frame", {
                Size = UDim2.fromOffset(o[2], o[2]), Position = o[3], BackgroundColor3 = o[1],
                BackgroundTransparency = 0.9, BorderSizePixel = 0, ZIndex = 1, Parent = bgLayer,
            })
            addCorner(orb, 100)
            TweenService:Create(orb, TweenInfo.new(o[5], Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                Position = o[4], BackgroundTransparency = 0.94,
            }):Play()
        end
        task.spawn(function()
            while alive do
                local sz = math.random(2, 4)
                local x = math.random()
                local p = new("Frame", {
                    Size = UDim2.fromOffset(sz, sz), Position = UDim2.new(x, 0, 1.05, 0), BackgroundColor3 = P.ACCENT2,
                    BackgroundTransparency = 0.5, BorderSizePixel = 0, ZIndex = 1, Parent = bgLayer,
                })
                addCorner(p, 100)
                local dur = math.random(8, 14)
                tween(p, dur, {
                    Position = UDim2.new(x + (math.random() - 0.5) * 0.2, 0, -0.05, 0), BackgroundTransparency = 1,
                }, Enum.EasingStyle.Linear)
                Debris:AddItem(p, dur + 0.1)
                task.wait(math.random(4, 9) / 10)
            end
        end)
    end

    -- title bar
    local titleBar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = P.PANEL, BackgroundTransparency = 0.25,
        BorderSizePixel = 0, ZIndex = 3, Parent = main,
    })
    new("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = WHITE,
        BackgroundTransparency = 0.94, BorderSizePixel = 0, ZIndex = 4, Parent = titleBar,
    })

    local logo = new("Frame", {
        Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(10, 8), BackgroundColor3 = WHITE,
        BorderSizePixel = 0, ZIndex = 4, Parent = titleBar,
    })
    addCorner(logo, 9)
    local logoGrad = new("UIGradient", { Rotation = 45, Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = logo })
    TweenService:Create(logoGrad, TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 225 }):Play()
    if cfg.Icon and cfg.Icon ~= "" then
        local img = new("ImageLabel", {
            Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1,
            Image = cfg.Icon, ScaleType = Enum.ScaleType.Fit, ZIndex = 5, Parent = logo,
        })
        addCorner(img, 7)
    else
        new("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = utf8Prefix(win.Title, 1):upper(),
            TextColor3 = WHITE, Font = Enum.Font.GothamBlack, TextSize = 15, ZIndex = 5, Parent = logo,
        })
    end

    local titleLabel = new("TextLabel", {
        Size = UDim2.new(1, -160, 1, 0), Position = UDim2.fromOffset(50, 0), BackgroundTransparency = 1, Text = " ",
        TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4, Parent = titleBar,
    })
    local titleGrad = new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, P.ACCENT2), ColorSequenceKeypoint.new(0.5, WHITE), ColorSequenceKeypoint.new(1, P.ACCENT),
        }),
        Offset = Vector2.new(-0.5, 0), Parent = titleLabel,
    })
    TweenService:Create(titleGrad, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
        Offset = Vector2.new(0.5, 0),
    }):Play()

    task.spawn(function()
        local full = win.Title
        local n = utf8.len(full) or #full
        local function put(txt)
            local cur = (math.floor(tick() * 2) % 2 == 0) and "|" or " "
            titleLabel.Text = txt .. " " .. cur
        end
        while alive do
            for i = 1, n do
                if not alive then return end
                put(utf8Prefix(full, i)); task.wait(0.07)
            end
            for _ = 1, 36 do
                if not alive then return end
                put(full); task.wait(0.08)
            end
            for i = n - 1, 0, -1 do
                if not alive then return end
                put(utf8Prefix(full, i)); task.wait(0.04)
            end
            task.wait(0.35)
        end
    end)

    -- window drag (mouse + touch)
    do
        local dragging, startPos, origin
        titleBar.InputBegan:Connect(function(i)
            if isPress(i) then
                dragging = true
                startPos = i.Position
                origin = main.Position
            end
        end)
        maid:Add(UserInputService.InputChanged:Connect(function(i)
            if dragging and isMove(i) then
                local d = i.Position - startPos
                main.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
            end
        end))
        maid:Add(UserInputService.InputEnded:Connect(function(i)
            if dragging and isPress(i) then dragging = false end
        end))
    end

    -- controls
    local function ctrlBtn(txt, xOff, hoverColor)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, xOff, 0, 9), BackgroundColor3 = P.ELEM,
            BackgroundTransparency = 0.4, Text = txt, TextColor3 = P.MUTED, Font = Enum.Font.GothamBold,
            TextSize = 13, AutoButtonColor = false, ZIndex = 5, Parent = titleBar,
        })
        addCorner(b, 9)
        b.MouseEnter:Connect(function()
            tween(b, 0.12, { BackgroundColor3 = hoverColor, BackgroundTransparency = 0, TextColor3 = WHITE })
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.12, { BackgroundColor3 = P.ELEM, BackgroundTransparency = 0.4, TextColor3 = P.MUTED })
        end)
        return b
    end
    local btnMin   = ctrlBtn("-", -70, P.HOVER)
    local btnClose = ctrlBtn("x", -38, P.DANGER)

    -- body
    local body = new("Frame", {
        Size = UDim2.new(1, 0, 1, -46), Position = UDim2.fromOffset(0, 46), BackgroundTransparency = 1,
        ZIndex = 2, Parent = main,
    })

    local sidebar = new("Frame", {
        Size = UDim2.new(0, 158, 1, -16), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = P.PANEL,
        BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 3, Parent = body,
    })
    addCorner(sidebar, 12)
    addStroke(sidebar, WHITE, 1, 0.95)

    local tabScroll = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -44), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 4, Parent = sidebar,
    })
    new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabScroll })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = tabScroll,
    })

    local footer = new("Frame", {
        Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), BackgroundColor3 = P.ELEM,
        BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 4, Parent = sidebar,
    })
    addCorner(footer, 9)
    local playerName = "player"
    pcall(function() playerName = Players.LocalPlayer.DisplayName end)
    new("TextLabel", {
        Size = UDim2.new(1, -16, 0, 16), Position = UDim2.fromOffset(10, 3), BackgroundTransparency = 1, Text = playerName,
        TextColor3 = P.TEXT, Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = footer,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -16, 0, 12), Position = UDim2.fromOffset(10, 18), BackgroundTransparency = 1,
        Text = "RYZE UI v" .. Lib.Version, TextColor3 = P.MUTED, Font = Enum.Font.Gotham, TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = footer,
    })

    local content = new("Frame", {
        Size = UDim2.new(1, -182, 1, -16), Position = UDim2.fromOffset(174, 8), BackgroundColor3 = P.PANEL,
        BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 3, Parent = body,
    })
    addCorner(content, 12)
    addStroke(content, WHITE, 1, 0.95)

    local searchBar = new("Frame", {
        Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = P.ELEM,
        BorderSizePixel = 0, ZIndex = 4, Parent = content,
    })
    addCorner(searchBar, 9)
    local searchStroke = addStroke(searchBar, WHITE, 1, 0.93)
    local sBox = new("TextBox", {
        Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
        PlaceholderText = "search...", PlaceholderColor3 = P.MUTED, Text = "", TextColor3 = P.TEXT,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, ZIndex = 5, Parent = searchBar,
    })
    sBox.Focused:Connect(function() tween(searchStroke, 0.15, { Color = P.ACCENT, Transparency = 0.3 }) end)
    sBox.FocusLost:Connect(function() tween(searchStroke, 0.15, { Color = WHITE, Transparency = 0.93 }) end)

    local pageHolder = new("Frame", {
        Size = UDim2.new(1, -16, 1, -56), Position = UDim2.fromOffset(8, 48), BackgroundTransparency = 1,
        ClipsDescendants = true, ZIndex = 3, Parent = content,
    })

    local function makePage(visible)
        local sf = new("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
            ScrollBarImageColor3 = P.ACCENT, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = visible, ZIndex = 3, Parent = pageHolder,
        })
        new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sf })
        new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = sf })
        return sf
    end

    local searchPage = makePage(false)
    local emptyLbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Text = "no results", TextColor3 = P.MUTED,
        Font = Enum.Font.GothamMedium, TextSize = 12, Visible = false, LayoutOrder = 99999, Parent = searchPage,
    })

    local function runSearch()
        local q = trim(sBox.Text):lower()
        for _, el in ipairs(win.Elements) do
            if el.Obj.Parent ~= el.Page then el.Obj.Parent = el.Page end
        end
        if q == "" then
            searchPage.Visible = false
            for _, p in pairs(win.Tabs) do p.Visible = (p == win.CurrentPage) end
            return
        end
        for _, p in pairs(win.Tabs) do p.Visible = false end
        searchPage.Visible = true
        local n = 0
        for _, el in ipairs(win.Elements) do
            if el.Name:lower():find(q, 1, true) then
                el.Obj.Parent = searchPage
                n += 1
            end
        end
        emptyLbl.Visible = (n == 0)
    end
    sBox:GetPropertyChangedSignal("Text"):Connect(runSearch)

    -- tabs
    function win:SelectTab(name)
        local page = self.Tabs[name]
        if not page then return end
        if sBox.Text ~= "" then sBox.Text = "" end
        self.CurrentPage, self.CurrentName = page, name
        for n, p in pairs(self.Tabs) do p.Visible = (n == name) end
        searchPage.Visible = false
        for n, b in pairs(self.TabButtons) do
            local active = (n == name)
            tween(b.Btn, 0.2, { BackgroundTransparency = active and 0.8 or 1, TextColor3 = active and P.TEXT or P.MUTED })
            tween(b.Bar, 0.25, { Size = UDim2.fromOffset(3, active and 16 or 0) }, Enum.EasingStyle.Back)
        end
        page.Position = UDim2.fromOffset(0, 16)
        tween(page, 0.3, { Position = UDim2.fromOffset(0, 0) })
    end

    function win:CreateTab(name)
        name = tostring(name)
        self._tabCount += 1
        local page = makePage(false)
        self.Tabs[name] = page

        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = P.ACCENT, BackgroundTransparency = 1,
            Text = name, TextColor3 = P.MUTED, Font = Enum.Font.GothamSemibold, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, LayoutOrder = self._tabCount,
            ZIndex = 5, Parent = tabScroll,
        })
        addCorner(btn, 9)
        new("UIPadding", { PaddingLeft = UDim.new(0, 16), Parent = btn })
        local bar = new("Frame", {
            Size = UDim2.fromOffset(3, 0), Position = UDim2.new(0, -10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 6, Parent = btn,
        })
        addCorner(bar, 100)
        new("UIGradient", { Rotation = 90, Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = bar })
        self.TabButtons[name] = { Btn = btn, Bar = bar }

        btn.MouseEnter:Connect(function()
            if self.CurrentName ~= name then tween(btn, 0.12, { BackgroundTransparency = 0.9, TextColor3 = P.TEXT }) end
        end)
        btn.MouseLeave:Connect(function()
            if self.CurrentName ~= name then tween(btn, 0.12, { BackgroundTransparency = 1, TextColor3 = P.MUTED }) end
        end)
        btn.MouseButton1Click:Connect(function() self:SelectTab(name) end)

        if not self.CurrentName then self:SelectTab(name) end

        local tab = { Page = page, Win = self, Name = name }
        function tab:CreateSection(t)   return B.Section(self.Win, self.Page, t) end
        function tab:CreateDivider()    return B.Divider(self.Win, self.Page) end
        function tab:CreateButton(c)    return B.Button(self.Win, self.Page, c or {}) end
        function tab:CreateToggle(c)    return B.Toggle(self.Win, self.Page, c or {}) end
        function tab:CreateSlider(c)    return B.Slider(self.Win, self.Page, c or {}) end
        function tab:CreateInput(c)     return B.Input(self.Win, self.Page, c or {}) end
        function tab:CreateDropdown(c)  return B.Dropdown(self.Win, self.Page, c or {}) end
        function tab:CreateKeybind(c)   return B.Keybind(self.Win, self.Page, c or {}) end
        function tab:CreateColorpicker(c) return B.Colorpicker(self.Win, self.Page, c or {}) end
        function tab:CreateLabel(t)     return B.Label(self.Win, self.Page, t) end
        function tab:CreateParagraph(c) return B.Paragraph(self.Win, self.Page, c) end
        return tab
    end

    -- minimize / close / toggle
    local minimized = false
    btnMin.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            tween(main, 0.3, { Size = UDim2.fromOffset(W, 46) })
            task.delay(0.2, function() if minimized then body.Visible = false end end)
        else
            body.Visible = true
            tween(main, 0.35, { Size = fullSize }, Enum.EasingStyle.Back)
        end
    end)

    local closing = false
    local function closeWindow()
        if closing then return end
        closing = true
        tween(winScale, 0.25, { Scale = 0.85 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.wait(0.27)
        gui:Destroy()
    end
    btnClose.MouseButton1Click:Connect(function() task.spawn(closeWindow) end)

    function win:Toggle() main.Visible = not main.Visible end
    function win:SetVisible(v) main.Visible = v and true or false end
    function win:Notify(c) Lib:Notify(c) end
    function win:Destroy() task.spawn(closeWindow) end

    if cfg.ToggleKey and cfg.ToggleKey ~= Enum.KeyCode.Unknown then
        maid:Add(UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == cfg.ToggleKey then
                main.Visible = not main.Visible
            end
        end))
    end

    -- floating toggle button for touch devices
    if cfg.MobileButton ~= false and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        local fab = new("TextButton", {
            Size = UDim2.fromOffset(44, 44), Position = UDim2.new(0, 14, 0.5, -22), BackgroundColor3 = WHITE,
            Text = utf8Prefix(win.Title, 1):upper(), TextColor3 = WHITE, Font = Enum.Font.GothamBlack, TextSize = 16,
            AutoButtonColor = false, ZIndex = 50, Parent = gui,
        })
        addCorner(fab, 100)
        new("UIGradient", { Rotation = 45, Color = ColorSequence.new(P.ACCENT, P.ACCENT2), Parent = fab })
        addStroke(fab, WHITE, 1.5, 0.6)
        fab.MouseButton1Click:Connect(function() main.Visible = not main.Visible end)
    end

    return win
end

-- ============================================================
-- PUBLIC: CreateWindow
-- With KeySystem=true this call YIELDS until the key is accepted and
-- returns the real window (nil if the prompt was closed).
-- ============================================================
function Lib:CreateWindow(cfg)
    cfg = cfg or {}
    local function build()
        local w = self:_CreateWindowCore(cfg)
        if type(cfg.OnKeySuccess) == "function" then task.spawn(cfg.OnKeySuccess, w) end
        return w
    end

    if cfg.KeySystem ~= true then return build() end

    applyTheme(cfg)
    local ks = cfg.KeySettings or {}
    local valid = buildValidKeys(ks)
    if #valid == 0 then
        warn("[RYZE UI] KeySystem is on but no valid keys were found. Skipping check.")
        return build()
    end

    local saved = (ks.SaveKey ~= false) and loadSavedKey(ks.FileName) or nil
    if saved and checkKey(saved, valid) then return build() end

    local result, finished = false, false
    showKeyPrompt(ks, valid, function(ok) result = ok; finished = true end)
    while not finished do task.wait(0.1) end
    if not result then return nil end
    return build()
end

return Lib
