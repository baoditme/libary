-- ============================================================
-- RYZE UI LIBRARY v1.3
-- Dark slate + accent + animated bg + typewriter title
-- Key prompt: fall + bounce + burst + loading + box slide
-- ============================================================

local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local CoreGui          = game:GetService("CoreGui")

local function getContainer()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    return CoreGui
end
local Container = getContainer()

pcall(function()
    local a = Container:FindFirstChild("RYZE_UI");        if a then a:Destroy() end
    local b = Container:FindFirstChild("RYZE_UI_Notify"); if b then b:Destroy() end
    local c = Container:FindFirstChild("RYZE_UI_Key");    if c then c:Destroy() end
end)

-- ============================================================
-- THEME
-- ============================================================
local DEFAULT_THEME = {
    BG     = Color3.fromRGB(15, 15, 18),
    PANEL  = Color3.fromRGB(22, 22, 27),
    ELEM   = Color3.fromRGB(28, 28, 35),
    HOVER  = Color3.fromRGB(38, 38, 48),
    ACCENT = Color3.fromRGB(115, 95, 245),
    TEXT   = Color3.fromRGB(240, 240, 245),
    MUTED  = Color3.fromRGB(140, 140, 155),
    DANGER = Color3.fromRGB(240, 70, 80),
}

local P = {}
for k, v in pairs(DEFAULT_THEME) do P[k] = v end

local function applyTheme(cfg)
    for k, v in pairs(DEFAULT_THEME) do P[k] = v end
    if cfg.Accent then P.ACCENT = cfg.Accent end
    if type(cfg.Theme) == "table" then
        for k, v in pairs(cfg.Theme) do
            if DEFAULT_THEME[k] then P[k] = v end
        end
    end
end

local function clamp255(v) return math.clamp(math.floor(v + 0.5), 0, 255) end
local function mixColor(a, b, t)
    return Color3.fromRGB(
        clamp255(a.R * 255 * (1 - t) + b.R * 255 * t),
        clamp255(a.G * 255 * (1 - t) + b.G * 255 * t),
        clamp255(a.B * 255 * (1 - t) + b.B * 255 * t)
    )
end

-- ============================================================
-- NOTIFY
-- ============================================================
local NOTIF_COLORS = {
    info    = Color3.fromRGB(115, 95, 245),
    success = Color3.fromRGB(80, 200, 120),
    warning = Color3.fromRGB(240, 150, 50),
    error   = Color3.fromRGB(240, 70, 80),
}

local notifyGui = Instance.new("ScreenGui")
notifyGui.Name = "RYZE_UI_Notify"
notifyGui.ResetOnSpawn = false
notifyGui.IgnoreGuiInset = true
notifyGui.DisplayOrder = 999
notifyGui.Parent = Container

local notifyContainer = Instance.new("Frame")
notifyContainer.Size = UDim2.new(0, 320, 1, 0)
notifyContainer.Position = UDim2.new(1, -340, 0, 20)
notifyContainer.BackgroundTransparency = 1
notifyContainer.Parent = notifyGui

local activeNotifs = {}
local N_HEIGHT, N_GAP = 68, 8

local Lib = {}
Lib.__index = Lib
Lib.Version = "1.3"

function Lib:Notify(cfg)
    cfg = cfg or {}
    local title    = cfg.Title or "Notification"
    local desc     = cfg.Desc or ""
    local ntype    = cfg.Type or "info"
    local duration = cfg.Duration or 3.5
    local color    = NOTIF_COLORS[ntype] or NOTIF_COLORS.info

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 320, 0, N_HEIGHT)
    frame.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = notifyContainer
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1
    stroke.Transparency = 0.92

    local iconBg = Instance.new("Frame")
    iconBg.Size = UDim2.new(0, 28, 0, 28)
    iconBg.Position = UDim2.new(0, 12, 0, 10)
    iconBg.BackgroundColor3 = color
    iconBg.BackgroundTransparency = 0.85
    iconBg.BorderSizePixel = 0
    iconBg.Parent = frame
    Instance.new("UICorner", iconBg).CornerRadius = UDim.new(0, 6)

    local iconText = Instance.new("TextLabel")
    iconText.Size = UDim2.fromScale(1, 1)
    iconText.BackgroundTransparency = 1
    iconText.Text = string.sub(title, 1, 1):upper()
    iconText.TextColor3 = color
    iconText.Font = Enum.Font.GothamBold
    iconText.TextSize = 14
    iconText.Parent = iconBg

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -54, 0, 18)
    titleLabel.Position = UDim2.new(0, 48, 0, 8)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = P.TEXT
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 13
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = frame

    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -54, 0, 30)
    descLabel.Position = UDim2.new(0, 48, 0, 26)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = desc
    descLabel.TextColor3 = Color3.fromRGB(150, 150, 165)
    descLabel.Font = Enum.Font.GothamMedium
    descLabel.TextSize = 11
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.TextWrapped = true
    descLabel.TextYAlignment = Enum.TextYAlignment.Top
    descLabel.Parent = frame

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, 0, 0, 2)
    bar.Position = UDim2.new(0, 0, 1, -2)
    bar.BackgroundColor3 = color
    bar.BorderSizePixel = 0
    bar.Parent = frame

    frame.Position = UDim2.new(1, 360, 0, 0)
    table.insert(activeNotifs, 1, frame)

    for i, f in ipairs(activeNotifs) do
        local targetY = (i - 1) * (N_HEIGHT + N_GAP)
        TweenService:Create(
            f,
            TweenInfo.new(f == frame and 0.35 or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            { Position = UDim2.new(0, 0, 0, targetY) }
        ):Play()
    end

    TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()

    task.delay(duration, function()
        for i, f in ipairs(activeNotifs) do
            if f == frame then table.remove(activeNotifs, i) break end
        end
        TweenService:Create(
            frame,
            TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            { Position = UDim2.new(1, 360, 0, frame.Position.Y.Offset) }
        ):Play()
        for i, f in ipairs(activeNotifs) do
            TweenService:Create(f, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {
                Position = UDim2.new(0, 0, 0, (i - 1) * (N_HEIGHT + N_GAP)),
            }):Play()
        end
        task.wait(0.35)
        frame:Destroy()
    end)
end

-- ============================================================
-- CLIPBOARD
-- ============================================================
local function copyToClipboard(text)
    if setclipboard then pcall(setclipboard, text) return true end
    if toclipboard then pcall(toclipboard, text) return true end
    if Clipboard and Clipboard.set then pcall(Clipboard.set, text) return true end
    return false
end

-- ============================================================
-- KEY SYSTEM HELPERS
-- ============================================================
local function _extractKeyList(keyField)
    if type(keyField) == "string" then return { keyField } end
    if type(keyField) == "table" then return keyField end
    return {}
end

local function _fetchRemoteKey(url)
    local body
    if game.HttpGet then
        local ok, res = pcall(game.HttpGet, game, url)
        if ok and res then body = res end
    end
    if not body then
        local http = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
        if http then
            local ok, res = pcall(http, { Url = url, Method = "GET" })
            if ok and res and res.Body then body = res.Body end
        end
    end
    if not body then return {} end
    local list = {}
    for line in body:gmatch("[^\r\n]+") do
        local trimmed = line:match("^%s*(.-)%s*$")
        if trimmed ~= "" then table.insert(list, trimmed) end
    end
    return list
end

local function _buildValidKeys(ks)
    local raw = _extractKeyList(ks.Key)
    local valid = {}
    if ks.GrabKeyFromSite and #raw > 0 then
        for _, item in ipairs(raw) do
            if type(item) == "string" and item:match("^https?://") then
                local remote = _fetchRemoteKey(item)
                for _, k in ipairs(remote) do table.insert(valid, k) end
            else
                table.insert(valid, item)
            end
        end
    else
        valid = raw
    end
    return valid
end

local function _checkKey(input, valid)
    if not input or input == "" then return false end
    for _, k in ipairs(valid) do
        if tostring(k) == tostring(input) then return true end
    end
    return false
end

local function _keyFilePath(fileName)
    local folder = "RYZE_UI_Keys"
    if isfolder and not isfolder(folder) then pcall(makefolder, folder) end
    return folder .. "/" .. tostring(fileName or "key") .. ".txt"
end

local function _loadSavedKey(fileName)
    local path = _keyFilePath(fileName)
    if isfile and isfile(path) then
        local ok, content = pcall(readfile, path)
        if ok and content and content ~= "" then return content end
    end
    return nil
end

local function _saveKey(fileName, key)
    local path = _keyFilePath(fileName)
    if writefile then pcall(writefile, path, tostring(key)) end
end

-- ============================================================
-- KEY PROMPT (intro + loading + box slide)
-- ============================================================
local function _showKeyPrompt(ks, valid, onSuccess)
    local gui = Instance.new("ScreenGui")
    gui.Name = "RYZE_UI_Key"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 10000
    gui.Parent = Container

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0
    bg.Parent = gui
    TweenService:Create(bg, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.5,
    }):Play()

    -- SNOW
    local snowLayer = Instance.new("Frame")
    snowLayer.Size = UDim2.fromScale(1, 1)
    snowLayer.BackgroundTransparency = 1
    snowLayer.BorderSizePixel = 0
    snowLayer.ClipsDescendants = true
    snowLayer.ZIndex = 1
    snowLayer.Parent = bg

    task.spawn(function()
        while gui.Parent do
            local sz = math.random(2, 4)
            local flake = Instance.new("Frame")
            flake.Size = UDim2.fromOffset(sz, sz)
            flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
            flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            flake.BackgroundTransparency = math.random(30, 70) / 100
            flake.BorderSizePixel = 0
            flake.ZIndex = 1
            flake.Parent = snowLayer
            Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)
            local dur = math.random(40, 80) / 10
            local drift = (math.random() - 0.5) * 0.15
            TweenService:Create(flake, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
                Position = UDim2.new(flake.Position.X.Scale + drift, 0, 1.05, 0),
                Rotation = math.random(-180, 180),
            }):Play()
            task.delay(dur, function() if flake and flake.Parent then flake:Destroy() end end)
            task.wait(math.random(8, 20) / 100)
        end
    end)

    -- INTRO TEXT (starts off-screen top)
    local introHolder = Instance.new("Frame")
    introHolder.Size = UDim2.fromScale(1, 1)
    introHolder.Position = UDim2.fromScale(0.5, -0.35)
    introHolder.AnchorPoint = Vector2.new(0.5, 0.5)
    introHolder.BackgroundTransparency = 1
    introHolder.ZIndex = 50
    introHolder.Parent = bg

    local introText = Instance.new("TextLabel")
    introText.Size = UDim2.fromScale(1, 1)
    introText.BackgroundTransparency = 1
    introText.Text = ks.Title or "RYZE HUB"
    introText.TextColor3 = Color3.fromRGB(225, 225, 235)
    introText.Font = Enum.Font.GothamBold
    introText.TextSize = 56
    introText.TextXAlignment = Enum.TextXAlignment.Center
    introText.TextYAlignment = Enum.TextYAlignment.Center
    introText.TextTransparency = 1
    introText.ZIndex = 51
    introText.Parent = introHolder

    local introStroke = Instance.new("UIStroke", introText)
    introStroke.Color = P.ACCENT
    introStroke.Thickness = 1.5
    introStroke.Transparency = 1

    local chromaR = introText:Clone()
    chromaR.TextColor3 = Color3.fromRGB(255, 70, 90)
    chromaR.TextTransparency = 1
    do local s = chromaR:FindFirstChildOfClass("UIStroke"); if s then s:Destroy() end end
    chromaR.Position = UDim2.fromOffset(1.5, 0)
    chromaR.ZIndex = 50
    chromaR.Parent = introHolder

    local chromaC = introText:Clone()
    chromaC.TextColor3 = Color3.fromRGB(80, 200, 255)
    chromaC.TextTransparency = 1
    do local s = chromaC:FindFirstChildOfClass("UIStroke"); if s then s:Destroy() end end
    chromaC.Position = UDim2.fromOffset(-1.5, 0)
    chromaC.ZIndex = 50
    chromaC.Parent = introHolder

    local glowInner = introText:Clone()
    glowInner.TextColor3 = P.ACCENT
    glowInner.TextSize = 68
    glowInner.TextTransparency = 1
    do local s = glowInner:FindFirstChildOfClass("UIStroke"); if s then s:Destroy() end end
    glowInner.ZIndex = 49
    glowInner.Parent = introHolder

    local glowOuter = introText:Clone()
    glowOuter.TextColor3 = mixColor(P.ACCENT, Color3.fromRGB(120, 200, 255), 0.6)
    glowOuter.TextSize = 86
    glowOuter.TextTransparency = 1
    do local s = glowOuter:FindFirstChildOfClass("UIStroke"); if s then s:Destroy() end end
    glowOuter.ZIndex = 48
    glowOuter.Parent = introHolder

    local shineLabel = introText:Clone()
    shineLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    shineLabel.TextTransparency = 1
    do local s = shineLabel:FindFirstChildOfClass("UIStroke"); if s then s:Destroy() end end
    shineLabel.ZIndex = 52
    shineLabel.Parent = introHolder
    local shineGrad = Instance.new("UIGradient", shineLabel)
    shineGrad.Rotation = 0
    shineGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0.00, 1),
        NumberSequenceKeypoint.new(0.42, 1),
        NumberSequenceKeypoint.new(0.50, 0),
        NumberSequenceKeypoint.new(0.58, 1),
        NumberSequenceKeypoint.new(1.00, 1),
    })
    shineGrad.Offset = Vector2.new(-0.6, 0)

    task.spawn(function()
        local t = 0
        while introText.Parent do
            t = t + 0.035
            glowInner.TextTransparency = 0.82 + math.sin(t) * 0.04
            glowOuter.TextTransparency = 0.92 + math.sin(t + 1.4) * 0.03
            RunService.RenderStepped:Wait()
        end
    end)

    task.spawn(function()
        task.wait(0.4)
        while shineLabel.Parent do
            local t0 = tick()
            local dur = 0.9
            while tick() - t0 < dur and shineLabel.Parent do
                local p = (tick() - t0) / dur
                shineGrad.Offset = Vector2.new(-0.6 + 1.2 * p, 0)
                RunService.RenderStepped:Wait()
            end
            task.wait(2.8)
        end
    end)

    local introScale = Instance.new("UIScale", introHolder)
    introScale.Scale = 1

    -- BOX (starts off-screen top)
    local box = Instance.new("Frame")
    box.Size = UDim2.fromOffset(440, 0)
    box.AutomaticSize = Enum.AutomaticSize.Y
    box.Position = UDim2.fromScale(0.5, -0.4)
