    t.Text = title
    t.TextColor3 = P.TEXT
    t.Font = Enum.Font.GothamBold
    t.TextSize = 12
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextWrapped = true
    t.LayoutOrder = 1
    t.Parent = fr

    local c = Instance.new("TextLabel")
    c.Size = UDim2.new(1, 0, 0, 0)
    c.AutomaticSize = Enum.AutomaticSize.Y
    c.BackgroundTransparency = 1
    c.Text = content
    c.TextColor3 = P.MUTED
    c.Font = Enum.Font.Gotham
    c.TextSize = 11
    c.TextXAlignment = Enum.TextXAlignment.Left
    c.TextYAlignment = Enum.TextYAlignment.Top
    c.TextWrapped = true
    c.LayoutOrder = 2
    c.Parent = fr

    registerEl(win, title, fr, page)
    local api = {}
    function api:SetContent(v) c.Text = tostring(v) end
    return api
end

-- ============================================================
-- WINDOW CORE
-- ============================================================
function Lib:_CreateWindowCore(cfg)
    cfg = cfg or {}
    applyTheme(cfg)
    local bgAnim = cfg.BgAnimation ~= false

    local win = {}
    win.Title       = cfg.Title or "RYZE UI"
    win.Size        = cfg.Size or UDim2.fromOffset(720, 520)
    win.Tabs        = {}
    win.TabButtons  = {}
    win.Elements    = {}
    win.CurrentTab  = nil
    win._layoutIndex = 0

    local gui = Instance.new("ScreenGui")
    gui.Name = "RYZE_UI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = Container
    win.Gui = gui

    local main = Instance.new("Frame")
    main.Size = win.Size
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.Position = UDim2.fromScale(0.5, 0.5)
    main.BackgroundColor3 = P.BG
    main.BorderSizePixel = 0
    main.Active = true
    main.Draggable = true
    main.ClipsDescendants = true
    main.Parent = gui
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)

    local mainStroke = Instance.new("UIStroke", main)
    mainStroke.Color = Color3.fromRGB(255, 255, 255)
    mainStroke.Thickness = 1
    mainStroke.Transparency = 0.93

    if bgAnim then
        local bgLayer = Instance.new("Frame")
        bgLayer.Size = UDim2.fromScale(1, 1)
        bgLayer.BackgroundColor3 = P.BG
        bgLayer.BorderSizePixel = 0
        bgLayer.ZIndex = 0
        bgLayer.ClipsDescendants = true
        bgLayer.Parent = main

        local gradFrame = Instance.new("Frame")
        gradFrame.Size = UDim2.fromScale(1, 1)
        gradFrame.BackgroundColor3 = Color3.new(1, 1, 1)
        gradFrame.BorderSizePixel = 0
        gradFrame.ZIndex = 0
        gradFrame.Parent = bgLayer

        local ug = Instance.new("UIGradient", gradFrame)
        ug.Rotation = 45
        ug.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, P.ACCENT),
            ColorSequenceKeypoint.new(0.5, P.BG),
            ColorSequenceKeypoint.new(1, P.ACCENT),
        })
        ug.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.82),
            NumberSequenceKeypoint.new(0.5, 0.9),
            NumberSequenceKeypoint.new(1, 0.82),
        })

        task.spawn(function()
            local angle = 45
            while gui.Parent do
                angle = (angle + 0.4) % 360
                ug.Rotation = angle
                RunService.RenderStepped:Wait()
            end
        end)

        task.spawn(function()
            while gui.Parent do
                local p = Instance.new("Frame")
                p.Size = UDim2.fromOffset(math.random(2, 4), math.random(2, 4))
                p.Position = UDim2.new(math.random(), 0, 1.05, 0)
                p.BackgroundColor3 = P.ACCENT
                p.BackgroundTransparency = 0.5
                p.BorderSizePixel = 0
                p.ZIndex = 0
                p.Parent = bgLayer
                Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
                local dur = math.random(8, 14)
                local drift = (math.random() - 0.5) * 0.2
                local target = UDim2.new(p.Position.X.Scale + drift, 0, -0.05, 0)
                TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
                    Position = target,
                    BackgroundTransparency = 1,
                }):Play()
                task.delay(dur, function() if p and p.Parent then p:Destroy() end end)
                task.wait(math.random(4, 8) / 10)
            end
        end)
    end

    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 42)
    titleBar.BackgroundColor3 = P.PANEL
    titleBar.BorderSizePixel = 0
    titleBar.ZIndex = 3
    titleBar.Parent = main
    Instance.new("UICorner", titleBar).CornerRadius = UDim.new(0, 12)

    local tbFix = Instance.new("Frame")
    tbFix.Size = UDim2.new(1, 0, 0, 10)
    tbFix.Position = UDim2.new(0, 0, 1, -10)
    tbFix.BackgroundColor3 = P.PANEL
    tbFix.BorderSizePixel = 0
    tbFix.ZIndex = 3
    tbFix.Parent = titleBar

    local avatar = Instance.new("Frame")
    avatar.Size = UDim2.new(0, 28, 0, 28)
    avatar.Position = UDim2.new(0, 8, 0.5, -14)
    avatar.BackgroundColor3 = P.ACCENT
    avatar.BackgroundTransparency = 0.8
    avatar.BorderSizePixel = 0
    avatar.ZIndex = 4
    avatar.Parent = titleBar
    Instance.new("UICorner", avatar).CornerRadius = UDim.new(0, 6)
    local avatarStroke = Instance.new("UIStroke", avatar)
    avatarStroke.Color = P.ACCENT
    avatarStroke.Thickness = 1.5

    if cfg.Icon and cfg.Icon ~= "" then
        avatar.BackgroundTransparency = 1
        local img = Instance.new("ImageLabel")
        img.Size = UDim2.fromScale(1, 1)
        img.BackgroundTransparency = 1
        img.Image = cfg.Icon
        img.ScaleType = Enum.ScaleType.Crop
        img.ZIndex = 4
        img.Parent = avatar
        Instance.new("UICorner", img).CornerRadius = UDim.new(0, 6)
    end

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(0, 0, 1, 0)
    titleLabel.AutomaticSize = Enum.AutomaticSize.X
    titleLabel.Position = UDim2.new(0, 44, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = " "
    titleLabel.TextColor3 = Color3.new(1, 1, 1)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 13
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 4
    titleLabel.Parent = titleBar

    local titleGrad = Instance.new("UIGradient", titleLabel)
    titleGrad.Rotation = 45

    task.spawn(function()
        local fullText = win.Title
        local cursorChar = "|"
        task.spawn(function()
            while gui.Parent and titleLabel.Parent do
                cursorChar = "|"
                task.wait(0.45)
                cursorChar = ""
                task.wait(0.45)
            end
        end)
        while gui.Parent and titleLabel.Parent do
            for _ = 1, 40 do
                if not gui.Parent or not titleLabel.Parent then return end
                titleLabel.Text = fullText .. " " .. cursorChar
                task.wait(0.05)
            end
            for len = #fullText - 1, 0, -1 do
                local sub = string.sub(fullText, 1, len)
                for _ = 1, 2 do
                    if not gui.Parent or not titleLabel.Parent then return end
                    titleLabel.Text = (sub == "" and "" or (sub .. " ")) .. cursorChar
                    task.wait(0.04)
                end
            end
            for _ = 1, 40 do
                if not gui.Parent or not titleLabel.Parent then return end
                titleLabel.Text = cursorChar
                task.wait(0.05)
            end
            for len = 1, #fullText do
                local sub = string.sub(fullText, 1, len)
                for _ = 1, 2 do
                    if not gui.Parent or not titleLabel.Parent then return end
                    titleLabel.Text = sub .. " " .. cursorChar
                    task.wait(0.04)
                end
            end
        end
    end)

    task.spawn(function()
        local speed, freq = 0.6, 1.8
        while gui.Parent and titleLabel.Parent do
            local t = tick() * speed
            local kp = {}
            for i = 0, 8 do
                local p = i / 8
                local hue = (t + p * freq) % 1
                table.insert(kp, ColorSequenceKeypoint.new(p, Color3.fromHSV(hue, 0.75, 1)))
            end
            titleGrad.Color = ColorSequence.new(kp)
            RunService.RenderStepped:Wait()
        end
    end)

    local winScale = Instance.new("UIScale", main)
    winScale.Scale = 0.85
    main.BackgroundTransparency = 0.3
    task.spawn(function()
        TweenService:Create(winScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = 1,
        }):Play()
        TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0,
        }):Play()
    end)

    local isMin = false
    local sidebar, content, searchBar
    local origSize = UDim2.new(win.Size.X.Scale, win.Size.X.Offset, win.Size.Y.Scale, win.Size.Y.Offset)

    -- Grouped ctrl [- | X]
    local ctrlGroup = Instance.new("Frame")
    ctrlGroup.Size = UDim2.fromOffset(58, 26)
    ctrlGroup.Position = UDim2.new(1, -66, 0, 8)
    ctrlGroup.BackgroundColor3 = P.ELEM
    ctrlGroup.BorderSizePixel = 0
    ctrlGroup.ClipsDescendants = true
    ctrlGroup.ZIndex = 4
    ctrlGroup.Parent = titleBar
    Instance.new("UICorner", ctrlGroup).CornerRadius = UDim.new(0, 8)
    local ctrlStroke = Instance.new("UIStroke", ctrlGroup)
    ctrlStroke.Color = Color3.fromRGB(255, 255, 255)
    ctrlStroke.Thickness = 1
    ctrlStroke.Transparency = 0.94

    local btnMin = Instance.new("TextButton")
    btnMin.Size = UDim2.new(0, 28, 1, 0)
    btnMin.Position = UDim2.new(0, 0, 0, 0)
    btnMin.BackgroundColor3 = P.HOVER
    btnMin.BackgroundTransparency = 1
    btnMin.Text = "-"
    btnMin.TextColor3 = P.TEXT
    btnMin.Font = Enum.Font.GothamMedium
    btnMin.TextSize = 14
    btnMin.AutoButtonColor = false
    btnMin.ZIndex = 5
    btnMin.Parent = ctrlGroup
    Instance.new("UICorner", btnMin).CornerRadius = UDim.new(0, 8)

    local btnClose = Instance.new("TextButton")
    btnClose.Size = UDim2.new(0, 28, 1, 0)
    btnClose.Position = UDim2.new(1, -28, 0, 0)
    btnClose.BackgroundColor3 = Color3.fromRGB(160, 40, 50)
    btnClose.BackgroundTransparency = 1
    btnClose.Text = "X"
    btnClose.TextColor3 = P.TEXT
    btnClose.Font = Enum.Font.GothamMedium
    btnClose.TextSize = 12
    btnClose.AutoButtonColor = false
    btnClose.ZIndex = 5
    btnClose.Parent = ctrlGroup
    Instance.new("UICorner", btnClose).CornerRadius = UDim.new(0, 8)

    local ctrlDivider = Instance.new("Frame")
    ctrlDivider.Size = UDim2.new(0, 1, 1, -10)
    ctrlDivider.Position = UDim2.new(0.5, 0, 0, 5)
    ctrlDivider.BackgroundColor3 = Color3.fromRGB(60, 60, 72)
    ctrlDivider.BorderSizePixel = 0
    ctrlDivider.ZIndex = 6
    ctrlDivider.Parent = ctrlGroup

    btnMin.MouseEnter:Connect(function()
        TweenService:Create(btnMin, TweenInfo.new(0.12), {
            BackgroundTransparency = 0,
            TextColor3 = Color3.new(1, 1, 1),
        }):Play()
    end)
    btnMin.MouseLeave:Connect(function()
        TweenService:Create(btnMin, TweenInfo.new(0.12), {
            BackgroundTransparency = 1,
            TextColor3 = P.TEXT,
        }):Play()
    end)

    btnClose.MouseEnter:Connect(function()
        TweenService:Create(btnClose, TweenInfo.new(0.12), {
            BackgroundTransparency = 0,
            TextColor3 = Color3.new(1, 1, 1),
        }):Play()
    end)
    btnClose.MouseLeave:Connect(function()
        TweenService:Create(btnClose, TweenInfo.new(0.12), {
            BackgroundTransparency = 1,
            TextColor3 = P.TEXT,
        }):Play()
    end)

    btnMin.MouseButton1Click:Connect(function()
        isMin = not isMin
        if sidebar then sidebar.Visible = not isMin end
        if content then content.Visible = not isMin end
        if searchBar then searchBar.Visible = not isMin end
        local targetSize
        if isMin then
            targetSize = UDim2.new(origSize.X.Scale, origSize.X.Offset, 0, 42)
        else
            targetSize = origSize
        end
        TweenService:Create(main, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = targetSize,
        }):Play()
    end)

    btnClose.MouseButton1Click:Connect(function()
        TweenService:Create(winScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Scale = 0.85,
        }):Play()
        TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
        }):Play()
        task.wait(0.3)
        gui:Destroy()
    end)

    sidebar = Instance.new("ScrollingFrame")
    sidebar.Size = UDim2.new(0, 150, 1, -50)
    sidebar.Position = UDim2.new(0, 6, 0, 46)
    sidebar.BackgroundColor3 = P.PANEL
    sidebar.BackgroundTransparency = 0.15
    sidebar.BorderSizePixel = 0
    sidebar.ScrollBarThickness = 2
    sidebar.ScrollBarImageColor3 = P.ACCENT
    sidebar.ScrollBarImageTransparency = 0.5
    sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    sidebar.AutomaticCanvasSize = Enum.AutomaticSize.Y
    sidebar.ScrollingDirection = Enum.ScrollingDirection.Y
    sidebar.ZIndex = 3
    sidebar.Parent = main
    Instance.new("UICorner", sidebar).CornerRadius = UDim.new(0, 10)

    local sidebarLayout = Instance.new("UIListLayout", sidebar)
    sidebarLayout.Padding = UDim.new(0, 4)
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local sidebarPad = Instance.new("UIPadding", sidebar)
    sidebarPad.PaddingTop = UDim.new(0, 6)
    sidebarPad.PaddingLeft = UDim.new(0, 6)
    sidebarPad.PaddingRight = UDim.new(0, 6)

    content = Instance.new("Frame")
    content.Size = UDim2.new(1, -168, 1, -50)
    content.Position = UDim2.new(0, 162, 0, 46)
    content.BackgroundColor3 = P.PANEL
    content.BackgroundTransparency = 0.15
    content.BorderSizePixel = 0
    content.ZIndex = 3
    content.Parent = main
    Instance.new("UICorner", content).CornerRadius = UDim.new(0, 10)

    searchBar = Instance.new("Frame")
    searchBar.Size = UDim2.new(1, -16, 0, 32)
    searchBar.Position = UDim2.new(0, 8, 0, 8)
    searchBar.BackgroundColor3 = P.ELEM
    searchBar.BorderSizePixel = 0
    searchBar.ZIndex = 4
    searchBar.Parent = content
    Instance.new("UICorner", searchBar).CornerRadius = UDim.new(0, 8)

    local sBox = Instance.new("TextBox")
    sBox.Size = UDim2.new(1, -16, 1, 0)
    sBox.Position = UDim2.new(0, 8, 0, 0)
    sBox.BackgroundTransparency = 1
    sBox.PlaceholderText = "search..."
    sBox.PlaceholderColor3 = P.MUTED
    sBox.Text = ""
    sBox.TextColor3 = P.TEXT
    sBox.Font = Enum.Font.GothamMedium
    sBox.TextSize = 12
    sBox.TextXAlignment = Enum.TextXAlignment.Left
    sBox.ClearTextOnFocus = false
    sBox.ZIndex = 5
    sBox.Parent = searchBar

    local searchPage = Instance.new("ScrollingFrame")
    searchPage.Size = UDim2.new(1, -16, 1, -56)
    searchPage.Position = UDim2.new(0, 8, 0, 48)
    searchPage.BackgroundTransparency = 1
    searchPage.BorderSizePixel = 0
    searchPage.ScrollBarThickness = 4
    searchPage.ScrollBarImageColor3 = P.ACCENT
    searchPage.CanvasSize = UDim2.new(0, 0, 0, 0)
    searchPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
    searchPage.Visible = false
    searchPage.ZIndex = 3
    searchPage.Parent = content
    local searchLayout = Instance.new("UIListLayout", searchPage)
    searchLayout.Padding = UDim.new(0, 6)
    searchLayout.SortOrder = Enum.SortOrder.LayoutOrder

    win._content    = content
    win._searchPage = searchPage
    win._sBox       = sBox

    sBox:GetPropertyChangedSignal("Text"):Connect(function()
        local txt = sBox.Text:lower()
        for _, el in ipairs(win.Elements) do
            if el.Obj and el.Obj.Parent then el.Obj.Parent = el.Page end
        end
        if txt == "" then
            searchPage.Visible = false
            if win.CurrentTab then win.CurrentTab.Visible = true end
            return
        end
        for _, pg in pairs(win.Tabs) do pg.Visible = false end
        searchPage.Visible = true
        for _, el in ipairs(win.Elements) do
            if el.Name and el.Name:lower():find(txt, 1, true) then
                el.Obj.Parent = searchPage
            end
        end
    end)

    function win:CreateTab(name, order)
        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.new(1, -16, 1, -56)
        page.Position = UDim2.new(0, 8, 0, 48)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 4
        page.ScrollBarImageColor3 = P.ACCENT
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.Visible = false
        page.ZIndex = 3
        page.Parent = content

        local layout = Instance.new("UIListLayout", page)
        layout.Padding = UDim.new(0, 6)
        layout.SortOrder = Enum.SortOrder.LayoutOrder

        self.Tabs[name] = page

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3 = P.ELEM
        btn.BackgroundTransparency = 1
        btn.Text = "  " .. name
        btn.TextColor3 = P.MUTED
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 13
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.LayoutOrder = order or (#self.Tabs)
        btn.AutoButtonColor = false
        btn.ZIndex = 4
        btn.Parent = sidebar
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

        btn.MouseButton1Click:Connect(function()
            sBox.Text = ""
            for _, p in pairs(self.Tabs) do p.Visible = false end
            for _, b in pairs(self.TabButtons) do
                b.BackgroundTransparency = 1
                b.TextColor3 = P.MUTED
            end
            page.Visible = true
            page.Position = UDim2.new(0, 8 + 22, 0, 48)
            TweenService:Create(page, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(0, 8, 0, 48),
            }):Play()
            self.CurrentTab = page
            btn.BackgroundTransparency = 0
            btn.BackgroundColor3 = P.ACCENT
            btn.TextColor3 = Color3.new(1, 1, 1)
        end)

        btn.MouseEnter:Connect(function()
            if btn.BackgroundTransparency == 1 then
                btn.BackgroundTransparency = 0.5
                btn.BackgroundColor3 = P.ELEM
            end
        end)
        btn.MouseLeave:Connect(function()
            if btn.BackgroundTransparency ~= 1 and btn.BackgroundColor3 ~= P.ACCENT then
                btn.BackgroundTransparency = 1
            end
        end)

        self.TabButtons[name] = btn

        if self.CurrentTab == nil then
            page.Visible = true
            self.CurrentTab = page
            btn.BackgroundTransparency = 0
            btn.BackgroundColor3 = P.ACCENT
            btn.TextColor3 = Color3.new(1, 1, 1)
        end

        local tab = {}
        tab.Page = page
        tab.Win = self
        tab.Name = name

        function tab:CreateSection(title)
            return B.Section(self.Win, self.Page, title)
        end
        function tab:CreateButton(c) return B.Button(self.Win, self.Page, c) end
        function tab:CreateToggle(c) return B.Toggle(self.Win, self.Page, c) end
        function tab:CreateSlider(c) return B.Slider(self.Win, self.Page, c) end
        function tab:CreateInput(c) return B.Input(self.Win, self.Page, c) end
        function tab:CreateDropdown(c) return B.Dropdown(self.Win, self.Page, c) end
        function tab:CreateKeybind(c) return B.Keybind(self.Win, self.Page, c) end
        function tab:CreateColorpicker(c) return B.Colorpicker(self.Win, self.Page, c) end
        function tab:CreateLabel(t) return B.Label(self.Win, self.Page, t) end
        function tab:CreateParagraph(c) return B.Paragraph(self.Win, self.Page, c) end

        return tab
    end

    function win:Notify(cfg) Lib:Notify(cfg) end
    function win:Destroy() gui:Destroy() end

    if cfg.ToggleKey and cfg.ToggleKey ~= Enum.KeyCode.Unknown then
        local key = cfg.ToggleKey
        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if not gui.Parent then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
                main.Visible = not main.Visible
            end
        end)
    end

    return win
end

-- ============================================================
-- PUBLIC CreateWindow
-- ============================================================
function Lib:CreateWindow(cfg)
    cfg = cfg or {}
    local function fire(window)
        if type(cfg.OnKeySuccess) == "function" then
            task.spawn(cfg.OnKeySuccess, window)
        end
    end

    if cfg.KeySystem == true then
        local ks = cfg.KeySettings or {}
        local valid = _buildValidKeys(ks)
        if #valid == 0 then
            print("[RYZE UI] KeySystem on but no valid keys. Skipping check.")
            local w = self:_CreateWindowCore(cfg)
            fire(w)
            return w
        end

        local saved = (ks.SaveKey ~= false) and _loadSavedKey(ks.FileName) or nil
        if saved and _checkKey(saved, valid) then
            local w = self:_CreateWindowCore(cfg)
            fire(w)
            return w
        end

        _showKeyPrompt(ks, valid, function()
            local w = self:_CreateWindowCore(cfg)
            fire(w)
        end)
        return nil
    end

    local w = self:_CreateWindowCore(cfg)
    fire(w)
    return w
end

return Lib
