    status.Font = Enum.Font.GothamMedium
    status.TextSize = 11
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.TextWrapped = true
    status.LayoutOrder = 6
    status.Parent = content

    local links = ks.Links or {}
    if #links > 0 then
        local divider = Instance.new("Frame")
        divider.Size = UDim2.new(1, 0, 0, 1)
        divider.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
        divider.BorderSizePixel = 0
        divider.LayoutOrder = 10
        divider.Parent = content

        local hint = Instance.new("TextLabel")
        hint.Size = UDim2.new(1, 0, 0, 14)
        hint.BackgroundTransparency = 1
        hint.Text = "Need a key? Click a link to copy it."
        hint.TextColor3 = P.MUTED
        hint.Font = Enum.Font.Gotham
        hint.TextSize = 10
        hint.TextXAlignment = Enum.TextXAlignment.Left
        hint.LayoutOrder = 11
        hint.Parent = content

        for i, link in ipairs(links) do
            local lb = Instance.new("TextButton")
            lb.Size = UDim2.new(1, 0, 0, 28)
            lb.BackgroundColor3 = P.ELEM
            lb.BackgroundTransparency = 0.6
            lb.Text = ""
            lb.AutoButtonColor = false
            lb.LayoutOrder = 12 + i
            lb.Parent = content
            Instance.new("UICorner", lb).CornerRadius = UDim.new(0, 6)

            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.fromOffset(16, 16)
            arrow.Position = UDim2.new(0, 10, 0.5, -8)
            arrow.BackgroundTransparency = 1
            arrow.Text = "→"
            arrow.TextColor3 = P.ACCENT
            arrow.Font = Enum.Font.GothamBold
            arrow.TextSize = 13
            arrow.Parent = lb

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -70, 1, 0)
            nameLbl.Position = UDim2.new(0, 30, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = tostring(link.Name or "Link")
            nameLbl.TextColor3 = P.TEXT
            nameLbl.Font = Enum.Font.GothamMedium
            nameLbl.TextSize = 11
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = lb

            local copyHint = Instance.new("TextLabel")
            copyHint.Size = UDim2.new(0, 60, 1, 0)
            copyHint.Position = UDim2.new(1, -68, 0, 0)
            copyHint.BackgroundTransparency = 1
            copyHint.Text = "copy"
            copyHint.TextColor3 = P.MUTED
            copyHint.Font = Enum.Font.GothamMedium
            copyHint.TextSize = 10
            copyHint.TextXAlignment = Enum.TextXAlignment.Right
            copyHint.Parent = lb

            lb.MouseEnter:Connect(function()
                TweenService:Create(lb, TweenInfo.new(0.12), {
                    BackgroundTransparency = 0.15,
                    BackgroundColor3 = P.ACCENT,
                }):Play()
                copyHint.TextColor3 = P.TEXT
            end)
            lb.MouseLeave:Connect(function()
                TweenService:Create(lb, TweenInfo.new(0.12), {
                    BackgroundTransparency = 0.6,
                    BackgroundColor3 = P.ELEM,
                }):Play()
                copyHint.TextColor3 = P.MUTED
                copyHint.Text = "copy"
            end)
            lb.MouseButton1Click:Connect(function()
                if link.Url and copyToClipboard(link.Url) then
                    copyHint.Text = "✓ copied"
                    copyHint.TextColor3 = Color3.fromRGB(80, 200, 120)
                    task.delay(1.4, function()
                        if copyHint and copyHint.Parent then
                            copyHint.Text = "copy"
                            copyHint.TextColor3 = P.MUTED
                        end
                    end)
                end
            end)
        end
    end

    local function doClose()
        TweenService:Create(box, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.fromScale(0.5, -0.4),
        }):Play()
        TweenService:Create(bg, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
        task.wait(0.3)
        gui:Destroy()
    end

    local function shakeBox()
        local orig = box.Position
        for _ = 1, 3 do
            box.Position = orig + UDim2.fromOffset(6, 0)
            task.wait(0.03)
            box.Position = orig - UDim2.fromOffset(6, 0)
            task.wait(0.03)
        end
        box.Position = orig
    end

    local function trySubmit()
        local entered = inputBox.Text
        if _checkKey(entered, valid) then
            if ks.SaveKey ~= false then _saveKey(ks.FileName, entered) end
            doClose()
            task.wait(0.3)
            onSuccess()
        else
            status.Text = "Invalid key, try again."
            inputBox.Text = ""
            shakeBox()
        end
    end

    verifyBtn.MouseButton1Click:Connect(trySubmit)
    inputBox.FocusLost:Connect(function(enter) if enter then trySubmit() end end)
    inputBox:GetPropertyChangedSignal("Text"):Connect(function() status.Text = "" end)
    closeBtn.MouseButton1Click:Connect(doClose)

    -- INTRO SEQUENCE
    task.spawn(function()
        task.wait(0.1)

        TweenService:Create(introText, TweenInfo.new(0.15), { TextTransparency = 0 }):Play()
        TweenService:Create(introStroke, TweenInfo.new(0.15), { Transparency = 0.5 }):Play()
        TweenService:Create(chromaR, TweenInfo.new(0.15), { TextTransparency = 0.94 }):Play()
        TweenService:Create(chromaC, TweenInfo.new(0.15), { TextTransparency = 0.94 }):Play()
        TweenService:Create(glowInner, TweenInfo.new(0.15), { TextTransparency = 0.85 }):Play()
        TweenService:Create(glowOuter, TweenInfo.new(0.15), { TextTransparency = 0.93 }):Play()
        TweenService:Create(shineLabel, TweenInfo.new(0.15), { TextTransparency = 0 }):Play()
        task.wait(0.15)

        -- Fall
        TweenService:Create(introHolder, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.fromScale(0.5, 0.5),
        }):Play()
        task.wait(0.55)

        -- Bounce 1
        TweenService:Create(introHolder, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.fromScale(0.5, 0.40),
        }):Play()
        task.wait(0.18)
        TweenService:Create(introHolder, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.fromScale(0.5, 0.5),
        }):Play()
        task.wait(0.14)

        -- Bounce 2
        TweenService:Create(introHolder, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.fromScale(0.5, 0.455),
        }):Play()
        task.wait(0.12)
        TweenService:Create(introHolder, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.fromScale(0.5, 0.5),
        }):Play()
        task.wait(0.09)

        -- Bounce 3
        TweenService:Create(introHolder, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.fromScale(0.5, 0.478),
        }):Play()
        task.wait(0.08)
        TweenService:Create(introHolder, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.fromScale(0.5, 0.5),
        }):Play()
        task.wait(0.06)

        task.wait(0.2)

        -- Burst
        local cX = bg.AbsoluteSize.X * 0.5
        local cY = bg.AbsoluteSize.Y * 0.5
        local N = 84
        for i = 1, N do
            local angle = (i / N) * math.pi * 2 + (math.random() - 0.5) * 0.18
            local fsz = math.random(3, 9)
            local flake = Instance.new("Frame")
            flake.Size = UDim2.fromOffset(fsz, fsz)
            flake.Position = UDim2.fromOffset(cX, cY)
            flake.AnchorPoint = Vector2.new(0.5, 0.5)
            flake.BackgroundColor3 = Color3.fromHSV(math.random(), 0.55, 1)
            flake.BackgroundTransparency = 0.05
            flake.BorderSizePixel = 0
            flake.ZIndex = 52
            flake.Rotation = math.random(0, 360)
            flake.Parent = bg
            Instance.new("UICorner", flake).CornerRadius = UDim.new(math.random(0, 1), 0)
            local dist = math.random(200, 440)
            local dur = math.random(60, 120) / 100
            local newRot = flake.Rotation + math.random(-540, 540)
            TweenService:Create(flake, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.fromOffset(cX + math.cos(angle) * dist, cY + math.sin(angle) * dist),
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(1, 1),
                Rotation = newRot,
            }):Play()
            task.delay(dur + 0.05, function() if flake and flake.Parent then flake:Destroy() end end)
        end

        TweenService:Create(introScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Scale = 0.15,
        }):Play()
        TweenService:Create(introText, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
        TweenService:Create(introStroke, TweenInfo.new(0.35), { Transparency = 1 }):Play()
        TweenService:Create(chromaR, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
        TweenService:Create(chromaC, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
        TweenService:Create(glowInner, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
        TweenService:Create(glowOuter, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
        TweenService:Create(shineLabel, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
        task.wait(0.4)
        introHolder:Destroy()

        -- LOADING
        local loadHolder = Instance.new("Frame")
        loadHolder.Size = UDim2.fromOffset(340, 0)
        loadHolder.AutomaticSize = Enum.AutomaticSize.Y
        loadHolder.Position = UDim2.fromScale(0.5, 0.5)
        loadHolder.AnchorPoint = Vector2.new(0.5, 0.5)
        loadHolder.BackgroundTransparency = 1
        loadHolder.ZIndex = 60
        loadHolder.Parent = bg

        local loadScale = Instance.new("UIScale", loadHolder)
        loadScale.Scale = 0.9
        TweenService:Create(loadScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = 1,
        }):Play()

        local loadLayout = Instance.new("UIListLayout", loadHolder)
        loadLayout.Padding = UDim.new(0, 12)
        loadLayout.SortOrder = Enum.SortOrder.LayoutOrder
        loadLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

        local loadBrand = Instance.new("TextLabel")
        loadBrand.Size = UDim2.new(1, 0, 0, 24)
        loadBrand.BackgroundTransparency = 1
        loadBrand.Text = ks.Title or "RYZE HUB"
        loadBrand.TextColor3 = P.TEXT
        loadBrand.Font = Enum.Font.GothamBold
        loadBrand.TextSize = 18
        loadBrand.LayoutOrder = 1
        loadBrand.Parent = loadHolder

        local loadBarTrack = Instance.new("Frame")
        loadBarTrack.Size = UDim2.new(1, 0, 0, 4)
        loadBarTrack.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        loadBarTrack.BorderSizePixel = 0
        loadBarTrack.LayoutOrder = 2
        loadBarTrack.Parent = loadHolder
        Instance.new("UICorner", loadBarTrack).CornerRadius = UDim.new(1, 0)

        local loadBarFill = Instance.new("Frame")
        loadBarFill.Size = UDim2.new(0, 0, 1, 0)
        loadBarFill.BackgroundColor3 = P.ACCENT
        loadBarFill.BorderSizePixel = 0
        loadBarFill.Parent = loadBarTrack
        Instance.new("UICorner", loadBarFill).CornerRadius = UDim.new(1, 0)

        local loadStatusRow = Instance.new("Frame")
        loadStatusRow.Size = UDim2.new(1, 0, 0, 18)
        loadStatusRow.BackgroundTransparency = 1
        loadStatusRow.LayoutOrder = 3
        loadStatusRow.Parent = loadHolder

        local loadPhase = Instance.new("TextLabel")
        loadPhase.Size = UDim2.new(1, -50, 1, 0)
        loadPhase.BackgroundTransparency = 1
        loadPhase.Text = "Initializing..."
        loadPhase.TextColor3 = P.MUTED
        loadPhase.Font = Enum.Font.GothamMedium
        loadPhase.TextSize = 11
        loadPhase.TextXAlignment = Enum.TextXAlignment.Left
        loadPhase.Parent = loadStatusRow

        local loadPct = Instance.new("TextLabel")
        loadPct.Size = UDim2.new(0, 50, 1, 0)
        loadPct.Position = UDim2.new(1, -50, 0, 0)
        loadPct.BackgroundTransparency = 1
        loadPct.Text = "0%"
        loadPct.TextColor3 = P.ACCENT
        loadPct.Font = Enum.Font.GothamBold
        loadPct.TextSize = 11
        loadPct.TextXAlignment = Enum.TextXAlignment.Right
        loadPct.Parent = loadStatusRow

        local loadPhases = {
            { text = "Loading UI...",          p = 0.20, dur = 0.35 },
            { text = "Loading features...",    p = 0.45, dur = 0.45 },
            { text = "Loading modules...",     p = 0.68, dur = 0.45 },
            { text = "Preparing key check...", p = 0.88, dur = 0.45 },
            { text = "Ready",                  p = 1.00, dur = 0.30 },
        }
        for _, ph in ipairs(loadPhases) do
            loadPhase.Text = ph.text
            loadPct.Text = tostring(math.floor(ph.p * 100)) .. "%"
            TweenService:Create(loadBarFill, TweenInfo.new(ph.dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(ph.p, 0, 1, 0),
            }):Play()
            task.wait(ph.dur)
        end

        task.wait(0.15)

        TweenService:Create(loadScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Scale = 0.6,
        }):Play()
        for _, el in ipairs(loadHolder:GetDescendants()) do
            if el:IsA("TextLabel") then
                TweenService:Create(el, TweenInfo.new(0.28), { TextTransparency = 1 }):Play()
            elseif el:IsA("Frame") then
                TweenService:Create(el, TweenInfo.new(0.28), { BackgroundTransparency = 1 }):Play()
            end
        end
        task.wait(0.32)
        loadHolder:Destroy()

        -- Box slides down
        box.Visible = true
        TweenService:Create(box, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.fromScale(0.5, 0.5),
        }):Play()
        task.wait(0.55)
        pcall(function() inputBox:CaptureFocus() end)
    end)
end

-- ============================================================
-- BUILDERS
-- ============================================================
local B = {}

local function nextLayout(win)
    win._layoutIndex = win._layoutIndex + 1
    return win._layoutIndex
end

local function registerEl(win, name, obj, page)
    table.insert(win.Elements, { Name = name, Obj = obj, Page = page })
end

local function addPressAnim(btn)
    local sc = Instance.new("UIScale", btn)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(sc, TweenInfo.new(0.08), { Scale = 0.97 }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(sc, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(sc, TweenInfo.new(0.12), { Scale = 1 }):Play()
    end)
end

function B.Section(win, page, title)
    local sec = Instance.new("Frame")
    sec.Size = UDim2.new(1, 0, 0, 24)
    sec.BackgroundTransparency = 1
    sec.Parent = page
    sec.LayoutOrder = nextLayout(win)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = string.lower(tostring(title))
    lbl.TextColor3 = P.MUTED
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = sec
    return sec
end

function B.Button(win, page, cfg)
    local text = cfg.Name or "Button"
    local cb = cfg.Callback or function() end
    local danger = cfg.Danger or false

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = danger and Color3.fromRGB(45, 25, 30) or P.ELEM
    btn.Text = text
    btn.TextColor3 = danger and Color3.fromRGB(255, 120, 130) or P.TEXT
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.AutoButtonColor = false
    btn.Parent = page
    btn.LayoutOrder = nextLayout(win)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local s = Instance.new("UIStroke", btn)
    s.Color = Color3.fromRGB(255, 255, 255)
    s.Thickness = 1
    s.Transparency = 0.94

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = danger and Color3.fromRGB(60, 30, 38) or P.HOVER,
        }):Play()
        TweenService:Create(s, TweenInfo.new(0.15), { Transparency = 0.86 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = danger and Color3.fromRGB(45, 25, 30) or P.ELEM,
        }):Play()
        TweenService:Create(s, TweenInfo.new(0.15), { Transparency = 0.94 }):Play()
    end)
    btn.MouseButton1Click:Connect(function() pcall(cb) end)
    addPressAnim(btn)

    registerEl(win, text, btn, page)

    local api = {}
    function api:SetText(newText) btn.Text = newText end
    return api, btn
end

function B.Toggle(win, page, cfg)
    local text = cfg.Name or "Toggle"
    local on = cfg.Default and true or false
    local cb = cfg.Callback or function() end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = P.ELEM
    btn.Text = "  " .. text
    btn.TextColor3 = P.TEXT
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = page
    btn.LayoutOrder = nextLayout(win)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local s = Instance.new("UIStroke", btn)
    s.Color = Color3.fromRGB(255, 255, 255)
    s.Thickness = 1
    s.Transparency = 0.94

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 28, 0, 14)
    pill.Position = UDim2.new(1, -36, 0.5, -7)
    pill.BackgroundColor3 = on and P.ACCENT or Color3.fromRGB(45, 45, 55)
    pill.BorderSizePixel = 0
    pill.Parent = btn
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 10, 0, 10)
    dot.Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
    dot.BackgroundColor3 = Color3.new(1, 1, 1)
    dot.BorderSizePixel = 0
    dot.Parent = pill
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    btn.MouseButton1Click:Connect(function()
        on = not on
        local c = on and P.ACCENT or Color3.fromRGB(45, 45, 55)
        local dp = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
        TweenService:Create(pill, TweenInfo.new(0.2, Enum.EasingStyle.Quart), { BackgroundColor3 = c }):Play()
        TweenService:Create(dot, TweenInfo.new(0.2, Enum.EasingStyle.Quart), { Position = dp }):Play()
        pcall(cb, on)
    end)
    addPressAnim(btn)

    registerEl(win, text, btn, page)

    local api = {}
    function api:Get() return on end
    function api:Set(v)
        v = v and true or false
        if v == on then return end
        on = v
        pill.BackgroundColor3 = on and P.ACCENT or Color3.fromRGB(45, 45, 55)
        dot.Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
        pcall(cb, on)
    end
    return api, btn
end

function B.Slider(win, page, cfg)
    local text = cfg.Name or "Slider"
    local minV = cfg.Min or 0
    local maxV = cfg.Max or 100
    local default = cfg.Default or minV
    local cb = cfg.Callback or function() end
    local suffix = cfg.Suffix or ""

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 46)
    frame.BackgroundColor3 = P.ELEM
    frame.BorderSizePixel = 0
    frame.Parent = page
    frame.LayoutOrder = nextLayout(win)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -70, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = P.TEXT
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 60, 0, 18)
    valLbl.Position = UDim2.new(1, -70, 0, 4)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(default) .. suffix
    valLbl.TextColor3 = P.MUTED
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 11
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Parent = frame

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 4)
    bar.Position = UDim2.new(0, 10, 0, 30)
    bar.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    bar.BorderSizePixel = 0
    bar.Parent = frame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local initP = (default - minV) / (maxV - minV)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initP, 0, 1, 0)
    fill.BackgroundColor3 = P.ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(initP, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.ZIndex = 3
    knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local btnArea = Instance.new("TextButton")
    btnArea.Size = UDim2.new(1, 20, 0, 30)
    btnArea.Position = UDim2.new(0, -10, 0, -13)
    btnArea.BackgroundTransparency = 1
    btnArea.Text = ""
    btnArea.ZIndex = 4
    btnArea.Parent = bar

    local dragging = false
    local current = default

    local function update(mx)
        local abs  = bar.AbsolutePosition.X
        local size = bar.AbsoluteSize.X
        if size <= 0 then return end
        local p = math.clamp((mx - abs) / size, 0, 1)
        local v = minV + p * (maxV - minV)
        v = (maxV - minV < 1) and (math.floor(v * 100) / 100) or math.floor(v)
        current = v
        valLbl.Text = tostring(v) .. suffix
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        pcall(cb, v)
    end

    btnArea.MouseButton1Down:Connect(function()
        dragging = true
        local sf = frame:FindFirstAncestorWhichIsA("ScrollingFrame")
        if sf then sf.ScrollingEnabled = false end
        update(UserInputService:GetMouseLocation().X)
    end)

    RunService.Heartbeat:Connect(function()
        if not dragging then return end
        if not frame.Parent then dragging = false return end
        update(UserInputService:GetMouseLocation().X)
    end)

    UserInputService.InputEnded:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and dragging then
            dragging = false
            for _, p in pairs(win.Tabs) do
                if p and p.Parent then p.ScrollingEnabled = true end
            end
        end
    end)

    registerEl(win, text, frame, page)

    local api = {}
    function api:Get() return current end
    function api:Set(v)
        v = math.clamp(v, minV, maxV)
        current = v
        valLbl.Text = tostring(v) .. suffix
        local p = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        pcall(cb, v)
    end
    return api, frame
end

function B.Input(win, page, cfg)
    local text = cfg.Name or "Input"
    local default = cfg.Default or ""
    local placeholder = cfg.Placeholder or ""
    local cb = cfg.Callback or function() end

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 60)
    frame.BackgroundColor3 = P.ELEM
    frame.BorderSizePixel = 0
    frame.Parent = page
    frame.LayoutOrder = nextLayout(win)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = P.MUTED
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -20, 0, 28)
    box.Position = UDim2.new(0, 10, 0, 26)
    box.BackgroundColor3 = P.BG
    box.Text = default
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = P.MUTED
    box.TextColor3 = P.TEXT
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.ClearTextOnFocus = false
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)

    box.FocusLost:Connect(function() pcall(cb, box.Text) end)

    registerEl(win, text, frame, page)

    local api = {}
    function api:Get() return box.Text end
    function api:Set(v) box.Text = tostring(v) end
    return api, frame
end

function B.Dropdown(win, page, cfg)
    local text = cfg.Name or "Dropdown"
    local options = cfg.Options or {}
    local current = cfg.Default or (options[1] or "")
    local cb = cfg.Callback or function() end

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 34)
    frame.BackgroundColor3 = P.ELEM
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = false
    frame.Parent = page
    frame.LayoutOrder = nextLayout(win)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -30, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text .. ":  " .. tostring(current)
    label.TextColor3 = P.TEXT
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -20, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "v"
    arrow.TextColor3 = P.MUTED
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 12
    arrow.Parent = frame

    local open, list = false, nil
    local BASE_Z, OPEN_Z = 5, 100

    local function closeList()
        if list then list:Destroy() list = nil end
        open = false
        frame.ZIndex = BASE_Z
    end

    btn.MouseButton1Click:Connect(function()
        if open then closeList() return end
        open = true
        frame.ZIndex = OPEN_Z

        list = Instance.new("ScrollingFrame")
        list.Size = UDim2.new(1, 0, 0, math.min(#options * 26, 200))
        list.Position = UDim2.new(0, 0, 1, 4)
        list.BackgroundColor3 = P.BG
        list.BorderSizePixel = 0
        list.ZIndex = OPEN_Z + 1
        list.ScrollBarThickness = 3
        list.CanvasSize = UDim2.new(0, 0, 0, #options * 26)
        list.Parent = frame
        Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)
        local ls = Instance.new("UIStroke", list)
        ls.Color = P.ACCENT
        ls.Thickness = 1
        ls.Transparency = 0.5
        Instance.new("UIListLayout", list)

        for _, opt in ipairs(options) do
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1, 0, 0, 26)
            ob.BackgroundColor3 = P.BG
            ob.Text = "  " .. tostring(opt)
            ob.TextColor3 = P.TEXT
            ob.Font = Enum.Font.Gotham
            ob.TextSize = 11
            ob.TextXAlignment = Enum.TextXAlignment.Left
            ob.ZIndex = OPEN_Z + 2
            ob.Parent = list
            ob.MouseEnter:Connect(function() ob.BackgroundColor3 = P.ELEM end)
            ob.MouseLeave:Connect(function() ob.BackgroundColor3 = P.BG end)
            ob.MouseButton1Click:Connect(function()
                current = opt
                label.Text = text .. ":  " .. tostring(opt)
                closeList()
                pcall(cb, opt)
            end)
        end
    end)

    registerEl(win, text, frame, page)

    local api = {}
    function api:Get() return current end
    function api:Set(v)
        current = v
        label.Text = text .. ":  " .. tostring(v)
    end
    return api, frame
end

function B.Keybind(win, page, cfg)
    local text = cfg.Name or "Keybind"
    local key = cfg.Default or Enum.KeyCode.Unknown
    local cb = cfg.Callback or function() end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = P.ELEM
    btn.Text = text .. ": " .. key.Name
    btn.TextColor3 = P.TEXT
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.AutoButtonColor = false
    btn.Parent = page
    btn.LayoutOrder = nextLayout(win)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local s = Instance.new("UIStroke", btn)
    s.Color = Color3.fromRGB(255, 255, 255)
    s.Thickness = 1
    s.Transparency = 0.94

    local waiting = false

    btn.MouseEnter:Connect(function()
        if not waiting then
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = P.HOVER }):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if not waiting then
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = P.ELEM }):Play()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        waiting = true
        btn.Text = text .. ": ..."
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if not waiting then return end
        if gp then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            waiting = false
            key = input.KeyCode
            btn.Text = text .. ": " .. key.Name
            pcall(cb, key)
        end
    end)
    addPressAnim(btn)

    registerEl(win, text, btn, page)

    local api = {}
    function api:Get() return key end
    function api:Set(k)
        key = k
        btn.Text = text .. ": " .. k.Name
        pcall(cb, k)
    end
    return api, btn
end

function B.Colorpicker(win, page, cfg)
    local text = cfg.Name or "Color"
    local default = cfg.Default or Color3.new(1, 1, 1)
    local cb = cfg.Callback or function() end

    local fr = Instance.new("Frame")
    fr.Size = UDim2.new(1, 0, 0, 76)
    fr.BackgroundColor3 = P.ELEM
    fr.BorderSizePixel = 0
    fr.Parent = page
    fr.LayoutOrder = nextLayout(win)
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -90, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = P.TEXT
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = fr

    local prev = Instance.new("Frame")
    prev.Size = UDim2.new(0, 70, 0, 18)
    prev.Position = UDim2.new(1, -80, 0, 4)
    prev.BackgroundColor3 = default
    prev.BorderSizePixel = 0
    prev.Parent = fr
    Instance.new("UICorner", prev).CornerRadius = UDim.new(0, 4)

    local cur = {
        math.floor(default.R * 255 + 0.5),
        math.floor(default.G * 255 + 0.5),
        math.floor(default.B * 255 + 0.5),
    }
    local labels = {}
    local fills = {}
    local sCol = {
        Color3.fromRGB(255, 80, 80),
        Color3.fromRGB(80, 255, 80),
        Color3.fromRGB(80, 80, 255),
    }
    local sLbl = { "R", "G", "B" }

    local function refresh()
        prev.BackgroundColor3 = Color3.fromRGB(cur[1], cur[2], cur[3])
        for i = 1, 3 do
            if labels[i] then labels[i].Text = tostring(cur[i]) end
            if fills[i] then fills[i].Size = UDim2.new(cur[i] / 255, 0, 1, 0) end
        end
        pcall(cb, prev.BackgroundColor3)
    end

    for i = 1, 3 do
        local yOff = 24 + (i - 1) * 17
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -20, 0, 14)
        row.Position = UDim2.new(0, 10, 0, yOff)
        row.BackgroundTransparency = 1
        row.Parent = fr

        local rl = Instance.new("TextLabel")
        rl.Size = UDim2.new(0, 14, 1, 0)
        rl.BackgroundTransparency = 1
        rl.Text = sLbl[i]
        rl.TextColor3 = sCol[i]
        rl.Font = Enum.Font.GothamBold
        rl.TextSize = 10
        rl.Parent = row

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, -66, 0, 6)
        bar.Position = UDim2.new(0, 16, 0.5, -3)
        bar.BackgroundColor3 = P.BG
        bar.BorderSizePixel = 0
        bar.Parent = row
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(cur[i] / 255, 0, 1, 0)
        fill.BackgroundColor3 = sCol[i]
        fill.BorderSizePixel = 0
        fill.Parent = bar
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
        fills[i] = fill

        local vlbl = Instance.new("TextLabel")
        vlbl.Size = UDim2.new(0, 34, 1, 0)
        vlbl.Position = UDim2.new(1, -38, 0, 0)
        vlbl.BackgroundTransparency = 1
        vlbl.Text = tostring(cur[i])
        vlbl.TextColor3 = P.TEXT
        vlbl.Font = Enum.Font.GothamBold
        vlbl.TextSize = 10
        vlbl.TextXAlignment = Enum.TextXAlignment.Right
        vlbl.Parent = row
        labels[i] = vlbl

        local tb = Instance.new("TextButton")
        tb.Size = UDim2.fromScale(1, 1)
        tb.BackgroundTransparency = 1
        tb.Text = ""
        tb.Parent = bar

        local dragging, idx = false, i
        local function upd(mx)
            local abs = bar.AbsolutePosition.X
            local sz = bar.AbsoluteSize.X
            if sz <= 0 then return end
            local p = math.clamp((mx - abs) / sz, 0, 1)
            cur[idx] = math.floor(p * 255 + 0.5)
            fill.Size = UDim2.new(p, 0, 1, 0)
            refresh()
        end
        tb.MouseButton1Down:Connect(function() dragging = true end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                upd(inp.Position.X)
            end
        end)
    end

    registerEl(win, text, fr, page)

    local api = {}
    function api:Get() return prev.BackgroundColor3 end
    function api:Set(c)
        cur[1] = math.floor(c.R * 255 + 0.5)
        cur[2] = math.floor(c.G * 255 + 0.5)
        cur[3] = math.floor(c.B * 255 + 0.5)
        refresh()
    end
    return api, fr
end

